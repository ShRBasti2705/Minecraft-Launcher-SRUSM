    in-out property <string> install_popup_pack_name: "";
    in property <[string]> install_popup_versions;
    in-out property <bool> install_popup_installing: false;
    in-out property <string> install_popup_status: "";
    in-out property <bool> compat_popup_visible: false;
    in property <[CompatibilityActionUi]> compat_actions;
    in-out property <bool> compat_conflict_visible: false;
    in property <[string]> compat_conflicts;
    in-out property <bool> import_popup_visible: false;
    in-out property <bool> import_busy: false;
    in-out property <bool> import_cf_popup_visible: false;
    in-out property <bool> import_cf_busy: false;
    in-out property <string> detail_instance_name: "";
    in-out property <image> detail_instance_icon;
    in property <[ModFileInfo]> detail_mod_files;
    in-out property <bool> detail_overrides_enabled: false;
    in-out property <int> detail_ram_mb: 2048;
    in-out property <string> detail_java_path: "";
    in-out property <string> detail_username: "";
    in-out property <bool> add_mod_popup_visible: false;
    in property <[BrowserPackInfo]> add_mod_results;
    in-out property <string> add_mod_status: "";
    in-out property <bool> misc_popup_visible: false;
    in property <[AccountInfo]> accounts;
    in-out property <string> accounts_status: "";
    in-out property <bool> ms_popup_visible: false;
    in property <string> ms_login_url: "";
    in-out property <bool> ms_busy: false;
    in-out property <string> ms_status: "";
    in-out property <int> items_per_page: 12;
    in-out property <bool> debug_ui: false;
    in-out property <string> settings_device_tier: "auto";
    in-out property <bool> recache_popup_visible: false;
    in-out property <string> recache_status: "";
    in-out property <float> recache_progress: 0.0;
    in property <[string]> debug_log;
    in property <[RunningInstance]> running_instances;
    in-out property <bool> running_bar_expanded: false;
    in-out property <bool> console_popup_visible: false;
    in-out property <string> console_instance_name: "";
    in property <[string]> console_lines;
    in-out property <bool> console_auto_scroll: true;
    in-out property <int> console_scroll_tick: 0;
    in-out property <int> playtime_tick: 0;
    in property <[AchievementUi]> achievements_recent;
    in property <[AchievementUi]> achievements_all;
    in property <string> achievements_summary: "";
    in-out property <bool> launch_popup_visible: false;
    in-out property <string> launch_instance: "";
    in-out property <string> launch_status: "";
    in-out property <float> launch_progress: 0.0;
    in-out property <string> mod_filter: "";
    in-out property <string> misc_jvm_args: "";
    in-out property <string> misc_preset_id: "none";
    in property <[JvmPresetUi]> misc_presets;
    in property <string> misc_suggestion: "";
    in property <[EnvVarUi]> misc_env_vars;
    in property <[WrapperUi]> misc_wrappers;
    in property <string> misc_wrapper_warning: "";
    in property <bool> misc_is_linux: false;
    in property <bool> misc_glfw_found: false;
    in-out property <bool> misc_use_system_glfw: true;
    in-out property <bool> misc_auto_fix_dupes: false;
    in-out property <string> misc_status: "";
    in property <[WorldInfoUi]> detail_worlds;
    in property <[ServerInfoUi]> detail_servers;
    in-out property <string> detail_worlds_status: "";
    in-out property <string> detail_servers_status: "";
    in property <[DuplicateUi]> detail_duplicates;
    in-out property <bool> manage_popup_visible: false;
    in-out property <string> manage_status: "";
    in property <[string]> manage_loader_versions;
    in-out property <string> manage_loader_current: "";
    in-out property <string> browser_source: "Modrinth";
    in property <[string]> available_java_paths;
    in property <[string]> available_accounts;
    in-out property <string> detail_ram_unit: "GB";
    in-out property <string> detail_java_selection: "Launcher Standard";
    in-out property <string> detail_account_selection: "Launcher Standard";
    in-out property <int> detail_window_width: 854;
    in-out property <int> detail_window_height: 480;
    in-out property <bool> detail_fullscreen: false;
    in-out property <float> detail_ram_gb_slider: 2.0;

    // ===== Haupt-Layout =====
    background: #0b0f17;
    min-width: 900px;
    min-height: 700px;
    preferred-width: 1280px;
    preferred-height: 800px;

    HorizontalLayout {
        // ===== Sidebar =====
        Rectangle {
            width: 220px;
            height: 100%;
            background: #111827;
            border-width: 1px;
            border-color: #1e293b;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 4px;
                Rectangle {
                    height: 60px;
                    background: #0f1419;
                    border-radius: 10px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: @linear-gradient(135deg, #10b981, #3b82f6);
                            Text {
                                text: "S";
                                color: white;
                                font-size: 18px;
                                font-weight: 900;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "SRUSM"; color: #f7fafc; font-size: 15px; font-weight: 800; }
                            Text { text: "Launcher"; color: #64748b; font-size: 10px; }
                        }
                    }
                }
                Rectangle { height: 12px; }
                NavButton {
                    text: "🎮  Instanzen";
                    active: root.selected_panel == "Instanzen" || root.selected_panel == "Instance Detail";
                    clicked => { root.selected_panel = "Instanzen" }
                }
                NavButton {
                    text: "🔍  Modpack Browser";
                    active: root.selected_panel == "Modpack Browser";
                    clicked => {
                        root.selected_panel = "Modpack Browser";
                        root.browser_search("", root.browser_source);
                    }
                }
                NavButton {
                    text: "📦  Presets";
                    active: root.selected_panel == "Presets";
                    clicked => {
                        root.selected_panel = "Presets";
                        root.preset_new_start();
                    }
                }
                NavButton {
                    text: "🖥️  Server";
                    active: root.selected_panel == "Server";
                    clicked => {
                        root.selected_panel = "Server";
                        root.srv_open();
                    }
                }
                NavButton {
                    text: "📊  Statistik";
                    active: root.selected_panel == "Statistik";
                    clicked => {
                        root.selected_panel = "Statistik";
                        root.stats_open();
                    }
                }
                NavButton {
                    text: "🏆  Achievements";
                    active: root.selected_panel == "Achievements";
                    clicked => {
                        root.selected_panel = "Achievements";
                        root.achievements_open();
                    }
                }
                Rectangle { height: 8px; }
                Rectangle { height: 1px; background: #1e293b; }
                Rectangle { height: 8px; }
                NavButton {
                    text: "👤  Accounts";
                    active: root.selected_panel == "Accounts";
                    clicked => { root.selected_panel = "Accounts" }
                }
                NavButton {
                    text: "⚙️  Settings";
                    active: root.selected_panel == "Settings";
                    clicked => { root.selected_panel = "Settings" }
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "v0.1.0";
                    color: #475569;
                    font-size: 10px;
                    horizontal-alignment: center;
                    padding: 8px;
                }
            }
        }

        // ===== Haupt-Content =====
        Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            background: #0b0f17;
            GridLayout {
                y: 0px;
                height: parent.height - running_bar.height;
                width: 100%;

                // ===== INSTANZEN =====
                if selected_panel == "Instanzen" : VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text { text: "Meine Instanzen"; color: #f7fafc; font-size: 24px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                        PrimaryButton { text: "+ Neue Instanz"; button-width: 140px; clicked => { root.popup_new_instance = true; } }
                        SecondaryButton { text: ".mrpack import"; button-width: 140px; clicked => { root.install_popup_status = ""; root.import_popup_visible = true; } }
                        SecondaryButton { text: "CurseForge .zip"; button-width: 150px; clicked => { root.install_popup_status = ""; root.import_cf_popup_visible = true; } }
                    }
                    instances_scroll := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: max(1, floor(((self.width / 1px) - 24) / 180));
                        GridLayout {
                            spacing: 16px;
                            padding: 4px;
                            for pack[i] in root.packs : ModpackTile {
                                row: floor(i / instances_scroll.cols);
                                col: mod(i, instances_scroll.cols);
                                name: pack.name;
                                playtime: root.instance_playtime(pack.name, root.playtime_tick);
                                icon: pack.icon;
                                starred: pack.starred;
                                modpack_play(n) => { root.modpack_play(n) }
                                modpack_details(n) => { root.open_instance_details(n) }
                                toggle_star(n) => { root.toggle_favorite("instances", n) }
                            }
                        }
                    }
                }

                // ===== MODPACK BROWSER =====
                if selected_panel == "Modpack Browser" : VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    Text { text: "Modpack Browser"; color: #f7fafc; font-size: 24px; font-weight: 800; }
                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 40px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            background: #0f1419;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1e293b;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text { text: "🔍"; color: #64748b; vertical-alignment: center; }
                                browser_search_box := LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Modpacks durchsuchen...";
                                    accepted(text) => { root.browser_search(text, root.browser_source) }
                                }
                            }
                        }
                        SecondaryButton { text: "Suchen"; button-width: 90px; clicked => { root.browser_search(browser_search_box.text, root.browser_source) } }
                    }
                    browser_scroll := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: max(1, floor(((self.width / 1px) - 16) / 296));
                        GridLayout {
                            spacing: 16px;
                            for pack[i] in root.browser_packs : BrowserTile {
                                row: floor(i / browser_scroll.cols);
                                col: mod(i, browser_scroll.cols);
                                project_id: pack.project_id;
                                name: pack.name;
                                summary: pack.summary;
                                author: pack.author;
                                icon: pack.icon;
                                source: pack.source;
                                starred: pack.starred;
                                install_clicked(id, n, src) => { root.browser_open_install(id, n, src) }
                                toggle_star(id) => { root.toggle_favorite("modpacks", id) }
                            }
                        }
                    }
                }

                // ===== SETTINGS =====
                if selected_panel == "Settings" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 20px;
                        alignment: start;
                        Text { text: "Einstellungen"; color: #f7fafc; font-size: 24px; font-weight: 800; }
                        MiscCard {
                            title: "Allgemein";
                            hint: "Standardwerte für neue Instanzen.";
                            VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    max-height: 32px;
                                    Text { text: "Standard-RAM"; color: #f7fafc; vertical-alignment: center; width: 140px; font-size: 13px; }
                                    ram_slider := Slider { minimum: 1024; maximum: 16384; value: root.default_ram_mb; horizontal-stretch: 1; }
                                    Text { text: round(ram_slider.value) + " MB"; color: #94a3b8; vertical-alignment: center; width: 80px; font-size: 13px; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    max-height: 32px;
                                    Text { text: "Java-Version"; color: #f7fafc; vertical-alignment: center; width: 140px; font-size: 13px; }
                                    ComboBox { model: root.available_java_paths; current-value <=> root.java_path; horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    max-height: 32px;
                                    Text { text: "Standard-Username"; color: #f7fafc; vertical-alignment: center; width: 140px; font-size: 13px; }
                                    username_box := LineEdit { placeholder-text: "TestUser"; text: root.default_username; horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    max-height: 32px;
                                    Text { text: "Elemente pro Seite"; color: #f7fafc; vertical-alignment: center; width: 140px; font-size: 13px; }
                                    items_slider := Slider { minimum: 4; maximum: 48; value: root.items_per_page; horizontal-stretch: 1; }
                                    Text { text: round(items_slider.value); color: #94a3b8; vertical-alignment: center; width: 40px; font-size: 13px; }
                                }
                            }
                        }
                        MiscCard {
                            title: "Performance";
                            hint: "Device-Tier steuert Icon-Größe, Log-Puffer und Download-Parallelität.";
                            VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    max-height: 32px;
                                    Text { text: "Device-Tier"; color: #f7fafc; vertical-alignment: center; width: 140px; font-size: 13px; }
                                    ComboBox { model: ["auto", "low", "mid", "high"]; current-value <=> root.settings_device_tier; horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    PrimaryButton { text: "Apply & Recache"; button-width: 180px; clicked => { root.apply_device_tier(root.settings_device_tier, true); } }
                                    SecondaryButton { text: "Nur speichern"; button-width: 140px; clicked => { root.apply_device_tier(root.settings_device_tier, false); } }
                                }
                            }
                        }
                        MiscCard {
                            title: "Launcher";
                            VerticalLayout {
                                spacing: 8px;
                                CheckBox { text: "Launcher beim Spielen minimieren"; checked: root.close_after_launch; }
                                CheckBox { text: "Beim Systemstart öffnen"; checked: root.open_on_startup; }
                                CheckBox { text: "Snapshot-Versionen anzeigen"; checked: root.show_snapshots; }
                            }
                        }
                        PrimaryButton {
                            text: "Einstellungen speichern";
                            button-width: 200px;
                            clicked => {
                                root.default_ram_mb = round(ram_slider.value);
                                root.default_username = username_box.text;
                                root.items_per_page = round(items_slider.value);
                                root.save_settings(
                                    root.default_ram_mb, root.java_path, root.default_username,
                                    root.close_after_launch, root.open_on_startup, root.show_snapshots,
                                    root.items_per_page, root.debug_ui,
                                );
                            }
                        }
                    }
                }

                // ===== PRESETS =====
                if selected_panel == "Presets" : VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    Text { text: "Presets"; color: #f7fafc; font-size: 24px; font-weight: 800; }
                    HorizontalLayout {
                        spacing: 16px;
                        vertical-stretch: 1;
                        Rectangle {
                            width: 280px;
                            background: #1a202c;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #1e293b;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text { text: "Meine Presets"; color: #f7fafc; font-weight: 700; font-size: 14px; }
                                if root.presets_status != "" : Text { text: root.presets_status; color: #94a3b8; font-size: 11px; wrap: word-wrap; }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 6px;
                                        for p in root.presets_list : Rectangle {
                                            height: 56px;
                                            background: root.preset_selected_id == p.id ? #2d3748 : #0f1419;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: root.preset_selected_id == p.id ? #3b82f6 : #1e293b;
                                            preset_area := TouchArea { clicked => { root.preset_select(p.id); } }
                                            VerticalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                padding-top: 8px;
                                                padding-bottom: 8px;
                                                spacing: 2px;
                                                Text { text: p.name; color: #f7fafc; font-weight: 700; font-size: 13px; overflow: elide; }
                                                Text { text: p.mc_version + " · " + p.loader + " · " + p.mod_count + " Mods"; color: #64748b; font-size: 10px; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 12px;
                            MiscCard {
                                title: "Neues Preset";
                                VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 10px;
                                        Text { text: "Name:"; color: #f7fafc; width: 80px; vertical-alignment: center; font-size: 13px; }
                                        LineEdit { placeholder-text: "z.B. Vanilla+ Performance"; text <=> root.preset_new_name; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 10px;
                                        Text { text: "MC-Version:"; color: #f7fafc; width: 80px; vertical-alignment: center; font-size: 13px; }
                                        ComboBox { model: root.mcVersions; current-value <=> root.preset_new_mc; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 10px;
                                        Text { text: "Loader:"; color: #f7fafc; width: 80px; vertical-alignment: center; font-size: 13px; }
                                        ComboBox { model: ["vanilla", "fabric", "forge", "neoforge", "quilt"]; current-value <=> root.preset_new_loader; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 10px;
                                        Text { text: "Mods (" + root.preset_new_mods.length + "):"; color: #f7fafc; width: 80px; vertical-alignment: center; font-size: 13px; }
                                        SecondaryButton { text: "+ Mod hinzufügen"; button-width: 150px; clicked => { root.preset_add_mod_popup_visible = true; root.preset_new_add_mod_search(""); } }
                                    }
                                    ScrollView {
                                        height: 140px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            for m in root.preset_new_mods : HorizontalLayout {
                                                height: 30px;
                                                spacing: 10px;
                                                Rectangle {
                                                    width: 24px; height: 24px; border-radius: 4px; background: #0f1419;
                                                    Image { source: m.icon; width: 24px; height: 24px; }
                                                }
                                                Text { text: m.project_name; color: #f7fafc; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                DangerButton { text: "Entfernen"; button-width: 90px; button-height: 26px; clicked => { root.preset_new_remove_mod(m.project_id); } }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 10px;
                                        PrimaryButton { text: "Preset speichern"; button-width: 160px; clicked => { root.preset_new_save(); } }
                                        SecondaryButton { text: "Preset löschen"; button-width: 140px; enabled: root.preset_selected_id != ""; clicked => { root.preset_delete(root.preset_selected_id); } }
                                    }
                                }
                            }
                            MiscCard {
                                title: "Auf Instanz anwenden";
                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 10px;
                                    ComboBox { model: root.preset_apply_targets_names; current-value <=> root.preset_apply_instance; horizontal-stretch: 1; }
                                    PrimaryButton { text: "Anwenden"; button-width: 120px; enabled: root.preset_selected_id != "" && root.preset_apply_instance != ""; clicked => { root.preset_apply(root.preset_selected_id, root.preset_apply_instance); } }
                                }
                            }
                        }
                    }
                }

                // ===== ACHIEVEMENTS =====
                if selected_panel == "Achievements" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        alignment: start;
                        Text { text: "Achievements"; color: #f7fafc; font-size: 24px; font-weight: 800; }
                        Text { text: root.achievements_summary; color: #10b981; font-size: 13px; }
                        Text { text: "Neueste 5"; font-size: 15px; font-weight: 700; color: #f7fafc; }
                        if root.achievements_recent.length == 0 : Text {
                            text: "Noch keine Achievements erfasst.";
                            color: #64748b;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        for a in root.achievements_recent : AchievementCard {
                            title: a.title_big;
                            description: a.description;
                            meta: a.meta;
                            kind: a.kind;
                            icon: a.icon;
                            is_new: a.is_new;
                        }
                        Rectangle { height: 12px; }
                        Text { text: "Pro Modpack"; font-size: 15px; font-weight: 700; color: #f7fafc; }
                        for a in root.achievements_all : VerticalLayout {
                            spacing: 4px;
                            if a.header != "" : Rectangle {
                                height: 36px;
                                header_area := TouchArea { clicked => { root.achievements_toggle(a.instance); } }
                                Text {
                                    text: a.header;
                                    color: header_area.has-hover ? #60a5fa : #3b82f6;
                                    font-size: 15px;
                                    font-weight: 800;
                                    vertical-alignment: bottom;
                                }
                            }
                            if !a.collapsed : HorizontalLayout {
                                height: 26px;
                                spacing: 12px;
                                Text {
                                    text: a.line;
                                    color: #10b981;
                                    font-weight: a.is_new ? 800 : 400;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text { text: a.short; color: #64748b; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; width: 100px; overflow: elide; }
                            }
                        }
                    }
                }

                // ===== STATISTIK =====
                if selected_panel == "Statistik" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;
                        alignment: start;
                        Text { text: "Statistik"; color: #f7fafc; font-size: 24px; font-weight: 800; }
                        Text { text: root.stats_summary; color: #10b981; wrap: word-wrap; }
                        MiscCard {
                            title: "Spielzeit pro Instanz";
                            VerticalLayout {
                                spacing: 8px;
                                for r in root.stats_instances : HorizontalLayout {
                                    height: 24px;
                                    spacing: 10px;
                                    Text { text: r.name; width: 220px; color: #f7fafc; vertical-alignment: center; overflow: elide; font-size: 13px; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Rectangle {
                                            width: parent.width * r.fraction;
                                            height: 14px;
                                            y: parent.height / 2 - 7px;
                                            background: #10b981;
                                            border-radius: 4px;
                                        }
                                    }
                                    Text { text: r.text; width: 120px; color: #94a3b8; vertical-alignment: center; font-size: 12px; }
                                }
                            }
                        }
                        MiscCard {
                            title: "Letzte 7 Tage";
                            VerticalLayout {
                                spacing: 8px;
                                for r in root.stats_days : HorizontalLayout {
                                    height: 24px;
                                    spacing: 10px;
                                    Text { text: r.name; width: 220px; color: #f7fafc; vertical-alignment: center; font-size: 13px; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Rectangle {
                                            width: parent.width * r.fraction;
                                            height: 14px;
                                            y: parent.height / 2 - 7px;
                                            background: #3b82f6;
                                            border-radius: 4px;
                                        }
                                    }
                                    Text { text: r.text; width: 120px; color: #94a3b8; vertical-alignment: center; font-size: 12px; }
                                }
                            }
                        }
                        MiscCard {
                            title: "Startzeit bis Hauptmenü";
                            if root.stats_startups.length == 0 : Text {
                                text: "Noch keine Messung.";
                                color: #64748b;
                                font-size: 12px;
                            }
                            VerticalLayout {
                                spacing: 8px;
                                for r in root.stats_startups : HorizontalLayout {
                                    height: 24px;
                                    spacing: 10px;
                                    Text { text: r.name; width: 220px; color: #f7fafc; vertical-alignment: center; overflow: elide; font-size: 13px; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Rectangle {
                                            width: parent.width * r.fraction;
                                            height: 14px;
                                            y: parent.height / 2 - 7px;
                                            background: #f59e0b;
                                            border-radius: 4px;
                                        }
                                    }
                                    Text { text: r.text; width: 230px; color: #94a3b8; vertical-alignment: center; font-size: 12px; }
                                }
                            }
                        }
                    }
                }

                // ===== SERVER =====
                if selected_panel == "Server" : HorizontalLayout {
                    padding: 24px;
                    spacing: 20px;
                    VerticalLayout {
                        width: 300px;
                        spacing: 12px;
                        Text { text: "Server"; color: #f7fafc; font-size: 24px; font-weight: 800; }
                        Rectangle {
                            background: #1a202c;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #1e293b;
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                if root.srv_list.length == 0 : Text {
                                    text: "Noch keine Server.";
                                    color: #64748b;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    height: 50px;
                                }
                                for s in root.srv_list : Rectangle {
                                    height: 52px;
                                    background: root.srv_selected == s.name ? #2d3748 : #0f1419;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: root.srv_selected == s.name ? #3b82f6 : #1e293b;
                                    TouchArea { clicked => { root.srv_select(s.name); } }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: s.running ? #10b981 : #64748b;
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text { text: s.name; color: #f7fafc; font-weight: 700; font-size: 13px; overflow: elide; }
                                            Text {
                                                text: s.mc_version + " · " + s.loader + " · Port " + s.port
                                                    + (s.installed ? "" : " · nicht installiert")
                                                    + (s.port_conflict ? " · ⚠ Port doppelt" : "");
                                                color: s.port_conflict ? #f59e0b : #64748b;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        MiscCard {
                            title: "Neuer Server";
                            VerticalLayout {
                                spacing: 8px;
                                srv_new_name := LineEdit { placeholder-text: "Servername"; }
                                srv_new_mc := ComboBox { model: root.mcVersions; }
                                srv_new_loader := ComboBox { model: ["vanilla", "fabric", "forge", "neoforge"]; }
                                PrimaryButton { text: "Server anlegen"; width: 100%; clicked => { root.srv_create(srv_new_name.text, srv_new_mc.current-value, srv_new_loader.current-value); srv_new_name.text = ""; } }
                            }
                        }
                    }
                    if root.srv_selected == "" : Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            text: "Wähle links einen Server aus.";
                            color: #64748b;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if root.srv_selected != "" : ScrollView {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 12px;
                            alignment: start;
                            HorizontalLayout {
                                height: 36px;
                                spacing: 10px;
                                Text { text: root.srv_selected; font-size: 22px; font-weight: 900; color: #f7fafc; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                PrimaryButton { text: "Start"; button-width: 80px; clicked => { root.srv_start(root.srv_selected); } }
                                SecondaryButton { text: "Stop"; button-width: 80px; clicked => { root.srv_stop(root.srv_selected); } }
                                DangerButton { text: "Kill"; button-width: 70px; clicked => { root.srv_kill(root.srv_selected); } }
                                SecondaryButton { text: "Ordner"; button-width: 90px; clicked => { root.srv_open_folder(root.srv_selected); } }
                            }
                            if root.srv_status != "" : Text {
                                text: root.srv_status;
                                color: #10b981;
                                font-size: 12px;
                                wrap: word-wrap;
                                height: 36px;
                                vertical-alignment: top;
                                overflow: elide;
                            }
                            Rectangle {
                                height: 320px;
                                background: #0f1419;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #1e293b;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    srv_console_scroll := ScrollView {
                                        vertical-stretch: 1;
                                        property <int> observe_tick: root.srv_console_tick;
                                        changed observe_tick => { if (root.srv_autoscroll) { self.content-y = 1000000px; } }
                                        VerticalLayout {
                                            spacing: 1px;
                                            if root.srv_console_lines.length == 0 : Text {
                                                text: "(Noch keine Ausgabe.)";
                                                color: #64748b;
                                                font-size: 11px;
                                            }
                                            for line in root.srv_console_lines : Text {
                                                text: line;
                                                color: #e2e8f0;
                                                font-size: 11px;
                                                wrap: no-wrap;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 8px;
                                        srv_cmd_box := LineEdit {
                                            placeholder-text: "Befehl eingeben...";
                                            horizontal-stretch: 1;
                                            accepted(t) => { root.srv_command(root.srv_selected, t); srv_cmd_box.text = ""; }
                                        }
                                        PrimaryButton { text: "Senden"; button-width: 80px; button-height: 30px; clicked => { root.srv_command(root.srv_selected, srv_cmd_box.text); srv_cmd_box.text = ""; } }
                                        CheckBox { text: "Auto-Scroll"; checked <=> root.srv_autoscroll; }
                                    }
                                }
                            }
                            MiscCard {
                                title: "Einstellungen";
                                hint: "Änderungen gelten beim nächsten Start.";
                                VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 12px;
                                        Text { text: "RAM"; color: #f7fafc; vertical-alignment: center; width: 110px; font-size: 13px; }
                                        Slider { minimum: 1; maximum: 32; value <=> root.srv_ram_gb; horizontal-stretch: 1; }
                                        Text { text: round(root.srv_ram_gb) + " GB"; color: #94a3b8; vertical-alignment: center; width: 60px; font-size: 13px; }
                                    }
                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 12px;
                                        Text { text: "Port"; color: #f7fafc; vertical-alignment: center; width: 110px; font-size: 13px; }
                                        LineEdit { text <=> root.srv_prop_port; width: 100px; }
                                        Text { text: "Max. Spieler"; color: #f7fafc; vertical-alignment: center; width: 100px; font-size: 13px; }
                                        LineEdit { text <=> root.srv_prop_max; width: 80px; }
                                    }
                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 12px;
                                        Text { text: "MOTD"; color: #f7fafc; vertical-alignment: center; width: 110px; font-size: 13px; }
                                        LineEdit { text <=> root.srv_prop_motd; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 12px;
                                        Text { text: "Schwierigkeit"; color: #f7fafc; vertical-alignment: center; width: 110px; font-size: 13px; }
                                        ComboBox { model: ["peaceful", "easy", "normal", "hard"]; current-value <=> root.srv_prop_difficulty; width: 160px; }
                                    }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        height: 28px;
                                        CheckBox { text: "Whitelist"; checked <=> root.srv_prop_whitelist; }
                                        CheckBox { text: "Online-Modus"; checked <=> root.srv_prop_online; }
                                    }
                                    CheckBox { text: "Ich akzeptiere die Minecraft-EULA"; checked <=> root.srv_eula; }
                                    PrimaryButton { text: "Speichern"; button-width: 140px; clicked => {
                                        root.srv_save(root.srv_selected, round(root.srv_ram_gb * 1024), root.srv_eula, root.srv_prop_port, root.srv_prop_max, root.srv_prop_motd, root.srv_prop_difficulty, root.srv_prop_whitelist, root.srv_prop_online);
                                    } }
                                }
                            }
                            MiscCard {
                                title: "Server löschen";
                                if !root.srv_confirm_delete : SecondaryButton { text: "Server löschen..."; button-width: 170px; clicked => { root.srv_confirm_delete = true; } }
                                if root.srv_confirm_delete : HorizontalLayout {
                                    height: 32px;
                                    spacing: 10px;
                                    Text { text: "Wirklich löschen?"; color: #ef4444; vertical-alignment: center; horizontal-stretch: 1; }
                                    DangerButton { text: "Ja, löschen"; button-width: 120px; clicked => { root.srv_delete(root.srv_selected); } }
                                    SecondaryButton { text: "Abbrechen"; button-width: 100px; clicked => { root.srv_confirm_delete = false; } }
                                }
                            }
                        }
                    }
                }

                // ===== ACCOUNTS =====
                if selected_panel == "Accounts" : VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;
                    Text { text: "Accounts"; color: #f7fafc; font-size: 24px; font-weight: 800; }
                    MiscCard {
                        title: "Account hinzufügen";
                        VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                max-height: 32px;
                                account_username_box := LineEdit {
                                    placeholder-text: "Offline-Username...";
                                    horizontal-stretch: 1;
                                    accepted(text) => { root.account_add_offline(text); account_username_box.text = ""; }
                                }
                                PrimaryButton { text: "Offline hinzufügen"; button-width: 180px; clicked => { root.account_add_offline(account_username_box.text); account_username_box.text = ""; } }
                            }
                            SecondaryButton { text: "Microsoft-Account hinzufügen"; button-width: 240px; clicked => { root.account_add_microsoft(); } }
                        }
                    }
                    if root.accounts_status != "" : Text {
                        text: root.accounts_status;
                        color: #10b981;
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                    MiscCard {
                        title: "Gespeicherte Accounts";
                        VerticalLayout {
                            spacing: 8px;
                            for acc in root.accounts : HorizontalLayout {
                                max-height: 36px;
                                spacing: 10px;
                                Text {
                                    text: acc.username + " (" + acc.kind + ")" + (acc.selected ? "  – aktiv" : "");
                                    color: acc.selected ? #10b981 : #f7fafc;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    font-size: 13px;
                                }
                                SecondaryButton { text: "Auswählen"; button-width: 100px; button-height: 28px; enabled: !acc.selected; clicked => { root.account_select(acc.id); } }
                                DangerButton { text: "Entfernen"; button-width: 90px; button-height: 28px; clicked => { root.account_remove(acc.id); } }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // ===== INSTANCE DETAIL =====
                if selected_panel == "Instance Detail" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        HorizontalLayout {
                            max-height: 40px;
                            spacing: 12px;
                            SecondaryButton { text: "← Zurück"; button-width: 90px; clicked => { root.selected_panel = "Instanzen" } }
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 8px; background: #1a202c;
                                Image { source: root.detail_instance_icon; width: 36px; height: 36px; }
                            }
                            Text { text: root.detail_instance_name; font-size: 22px; font-weight: 900; color: #f7fafc; vertical-alignment: center; }
                            Text { text: "Spielzeit: " + root.instance_playtime(root.detail_instance_name, root.playtime_tick); color: #10b981; font-size: 12px; vertical-alignment: center; }
                        }
                        MiscCard {
                            title: "Mods";
                            VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    max-height: 32px;
                                    spacing: 10px;
                                    alignment: start;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        background: #0f1419;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #1e293b;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            Text { text: "🔍"; color: #64748b; vertical-alignment: center; }
                                            LineEdit {
                                                placeholder-text: "Mods durchsuchen...";
                                                text <=> root.mod_filter;
                                                horizontal-stretch: 1;
                                                edited(t) => { root.detail_filter_mods(root.detail_instance_name, t) }
                                            }
                                        }
                                    }
                                    PrimaryButton { text: "+ Mod hinzufügen"; button-width: 150px; clicked => { root.add_mod_popup_visible = true; root.add_mod_status = ""; root.detail_add_mod_search(""); } }
                                    SecondaryButton { text: "Ordner öffnen"; button-width: 130px; clicked => { root.detail_open_folder(root.detail_instance_name) } }
                                    SecondaryButton { text: "Misc"; button-width: 80px; clicked => { root.misc_open(root.detail_instance_name) } }
                                    SecondaryButton { text: "Absturz-Analyse"; button-width: 150px; clicked => { root.crash_analyze(root.detail_instance_name) } }
                                    SecondaryButton { text: "Manage"; button-width: 100px; clicked => { root.manage_open(root.detail_instance_name); root.manage_update_load(root.detail_instance_name); } }
                                }
                                mods_scroll := ScrollView {
                                    height: 280px;
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 4px;
                                        for mod_file in root.detail_mod_files : Rectangle {
                                            height: 32px;
                                            background: mod_area.has-hover ? #232b3a : #0f1419;
                                            border-radius: 6px;
                                            mod_area := TouchArea {}
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 10px;
                                                Rectangle {
                                                    width: 24px; height: 24px; border-radius: 4px; background: #1a202c;
                                                    Image { source: mod_file.icon; width: 24px; height: 24px; }
                                                }
                                                Text {
                                                    text: mod_file.display_name;
                                                    color: mod_file.duplicate ? #f59e0b : (mod_file.orphan ? #a78bfa : (mod_file.enabled ? #f7fafc : #64748b));
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                    font-size: 13px;
                                                }
                                                SecondaryButton {
                                                    text: mod_file.enabled ? "Deaktivieren" : "Aktivieren";
                                                    button-width: 110px;
                                                    button-height: 26px;
                                                    clicked => { root.detail_toggle_mod(root.detail_instance_name, mod_file.filename) }
                                                }
                                                DangerButton {
                                                    text: "Entfernen";
                                                    button-width: 90px;
                                                    button-height: 26px;
                                                    clicked => { root.detail_remove_mod(root.detail_instance_name, mod_file.filename) }
                                                }
                                            }
                                        }
                                        if root.dup_total > 0 : Rectangle { height: 1px; background: #1e293b; }
                                        if root.dup_total > 0 : Text { text: "Doppelte Mods (" + root.dup_total + ")"; color: #f59e0b; font-weight: 700; }
                                        if root.dup_total > 0 : VerticalLayout {
                                            spacing: 0px;
                                            for m in root.detail_mod_files : Rectangle {
                                                height: m.duplicate ? 24px : 0px;
                                                clip: true;
                                                Text { text: m.display_name; color: #f59e0b; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                        if root.dup_total > 0 : HorizontalLayout {
                                            height: 32px;
                                            spacing: 10px;
                                            SecondaryButton {
                                                text: "Doppelte Mods beheben...";
                                                button-width: 210px;
                                                enabled: root.misc_auto_fix_dupes;
                                                clicked => { root.duplicates_fix(root.detail_instance_name) }
                                            }
                                            Text {
                                                text: root.misc_auto_fix_dupes ? root.dup_status : "Gesperrt: im Misc-Popup aktivieren.";
                                                color: #94a3b8;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            background: #1a202c;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #1e293b;
                            height: 280px;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        height: 24px;
                                        Text { text: "Welten"; color: #f7fafc; font-weight: 700; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                        Text { text: root.detail_worlds_status; color: #94a3b8; font-size: 11px; vertical-alignment: center; }
                                    }
                                    if root.detail_worlds.length == 0 : Text { text: "Keine Welten."; color: #64748b; font-size: 11px; }
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 4px;
                                            for w in root.detail_worlds : Rectangle {
                                                height: 36px;
                                                background: world_area.has-hover ? #232b3a : #0f1419;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: #1e293b;
                                                world_area := TouchArea { }
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    padding-top: 6px;
                                                    padding-bottom: 6px;
                                                    spacing: 8px;
                                                    Rectangle { width: 24px; height: 24px; border-radius: 4px; background: #1a202c; Image { source: w.icon; width: 24px; height: 24px; } }
                                                    VerticalLayout {
                                                        spacing: 0px;
                                                        Text { text: w.display_name + (w.hardcore ? "  ☠" : ""); color: w.hardcore ? #ef4444 : #f7fafc; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                        Text { text: w.game_type_text + " · " + w.version + " · " + w.last_played_text; color: #64748b; font-size: 9px; vertical-alignment: center; }
                                                    }
                                                    PrimaryButton { text: "Play"; button-width: 60px; button-height: 24px; clicked => { root.world_play(root.detail_instance_name, w.folder_name) } }
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        height: 24px;
                                        Text { text: "Server"; color: #f7fafc; font-weight: 700; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                        Text { text: root.detail_servers_status; color: #94a3b8; font-size: 11px; vertical-alignment: center; }
                                        SecondaryButton { text: "Aktualisieren"; button-width: 110px; button-height: 22px; clicked => { root.refresh_servers(root.detail_instance_name) } }
                                    }
                                    if root.detail_servers.length == 0 : Text { text: "Keine Server."; color: #64748b; font-size: 11px; }
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 4px;
                                            for s in root.detail_servers : Rectangle {
                                                height: 36px;
                                                background: server_area.has-hover ? #232b3a : #0f1419;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: #1e293b;
                                                server_area := TouchArea { }
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    padding-top: 6px;
                                                    padding-bottom: 6px;
                                                    spacing: 8px;
                                                    Rectangle { width: 10px; height: 10px; border-radius: 5px; background: s.status == "online" ? #10b981 : s.status == "offline" ? #ef4444 : s.status == "checking" ? #f59e0b : #64748b; }
                                                    Rectangle { width: 24px; height: 24px; border-radius: 4px; background: #1a202c; Image { source: s.icon; width: 24px; height: 24px; } }
                                                    VerticalLayout {
                                                        spacing: 0px;
                                                        Text { text: s.name; color: #f7fafc; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                        Text { text: s.ip + (s.players_text != "" ? " · " + s.players_text : ""); color: #64748b; font-size: 9px; vertical-alignment: center; }
                                                    }
                                                    PrimaryButton { text: "Join"; button-width: 60px; button-height: 24px; clicked => { root.server_join(root.detail_instance_name, s.ip) } }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        MiscCard {
                            title: "Erweiterte Einstellungen";
                            VerticalLayout {
                                spacing: 12px;
                                detail_overrides_box := CheckBox { text: "Globale Einstellungen überschreiben"; checked <=> root.detail_overrides_enabled; }
                                if detail_overrides_box.checked : Rectangle {
                                    height: 360px;
                                    background: #0f1419;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #1e293b;
                                    VerticalLayout {
                                        spacing: 12px;
                                        padding: 14px;
                                        Text { text: "Arbeitsspeicher"; font-size: 13px; font-weight: 700; color: #94a3b8; }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            detail_ram_slider := Slider { minimum: 1; maximum: 32; value <=> root.detail_ram_gb_slider; horizontal-stretch: 1; }
                                            ComboBox { width: 80px; model: ["MB", "GB"]; current-value <=> root.detail_ram_unit; }
                                            Text {
                                                width: 80px;
                                                text: root.detail_ram_unit == "GB" ? round(detail_ram_slider.value) + " GB" : round(detail_ram_slider.value * 1024) + " MB";
                                                color: #f7fafc;
                                                vertical-alignment: center;
                                                font-weight: 700;
                                            }
                                        }
                                        Text { text: "Java-Version"; font-size: 13px; font-weight: 700; color: #94a3b8; }
                                        ComboBox { model: root.available_java_paths; current-value <=> root.detail_java_selection; }
                                        Text { text: "Benutzerkonto"; font-size: 13px; font-weight: 700; color: #94a3b8; }
                                        ComboBox { model: root.available_accounts; current-value <=> root.detail_account_selection; }
                                        Text { text: "Fenstergröße"; font-size: 13px; font-weight: 700; color: #94a3b8; }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: "B:"; color: #f7fafc; vertical-alignment: center; width: 30px; }
                                            SpinBox { value <=> root.detail_window_width; width: 80px; minimum: 640; maximum: 3840; }
                                            Text { text: "H:"; color: #f7fafc; vertical-alignment: center; width: 30px; }
                                            SpinBox { value <=> root.detail_window_height; width: 80px; minimum: 480; maximum: 2160; }
                                            CheckBox { text: "Vollbild"; checked <=> root.detail_fullscreen; }
                                        }
                                    }
                                }
                                PrimaryButton {
                                    text: "Einstellungen speichern";
                                    width: 100%;
                                    clicked => {
                                        let final_ram_mb = round(root.detail_ram_gb_slider * 1024);
                                        root.detail_save_overrides(root.detail_instance_name, root.detail_overrides_enabled, final_ram_mb, root.detail_java_selection, root.detail_account_selection, root.detail_window_width, root.detail_window_height, root.detail_fullscreen);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    running_bar := RunningBar {
        y: parent.height - self.height;
        width: 100%;
        instances: root.running_instances;
        expanded <=> root.running_bar_expanded;
        force_stop(n) => { root.force_stop(n) }
        open_console(n) => { root.console_open(n) }
    }

    // ===== Popups =====
    if popup_new_instance : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { popup_new_instance = false } }
        Rectangle {
            width: 500px; height: 420px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 16px;
                padding: 24px;
                Text { text: "Neue Instanz"; color: #f7fafc; font-size: 20px; font-weight: 800; horizontal-alignment: center; }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Name"; color: #94a3b8; font-size: 12px; }
                    instance_name := LineEdit { placeholder-text: "Instanzname..."; }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Minecraft Version"; color: #94a3b8; font-size: 12px; }
                    instance_version := ComboBox { model: mcVersions; }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Modloader"; color: #94a3b8; font-size: 12px; }
                    instance_modloader := ComboBox { model: ["Vanilla", "Fabric", "Forge", "neoforge"]; }
                }
                Rectangle { vertical-stretch: 1; }
                PrimaryButton { text: "Erstellen & Starten"; width: 100%; clicked => { create_and_run(instance_name.text, instance_version.current-value, instance_modloader.current-value) } }
            }
        }
    }

    if manage_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.manage_popup_visible = false } }
        Rectangle {
            width: 700px; height: 600px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    max-height: 32px;
                    Text { text: "Manage: " + root.detail_instance_name; color: #f7fafc; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    SecondaryButton { text: "Schließen"; button-width: 100px; clicked => { root.manage_popup_visible = false } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 14px;
                        padding: 4px;
                        MiscCard {
                            title: "Duplizieren";
                            hint: "Kopiert die komplette Instanz.";
                            HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                dup_name_box := LineEdit { placeholder-text: "Neuer Name"; horizontal-stretch: 1; }
                                PrimaryButton { text: "Duplizieren"; button-width: 120px; clicked => { root.manage_duplicate(root.detail_instance_name, dup_name_box.text) } }
                            }
                        }
                        MiscCard {
                            title: "Umbenennen";
                            hint: "Die Instanz darf nicht laufen.";
                            HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                rename_box := LineEdit { placeholder-text: "Neuer Name"; horizontal-stretch: 1; }
                                PrimaryButton { text: "Umbenennen"; button-width: 120px; clicked => { root.manage_rename(root.detail_instance_name, rename_box.text) } }
                            }
                        }
                        MiscCard {
                            title: "Exportieren";
                            HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                alignment: start;
                                SecondaryButton { text: "Als .zip"; button-width: 140px; clicked => { root.manage_export(root.detail_instance_name) } }
                                SecondaryButton { text: "Als .mrpack"; button-width: 150px; clicked => { root.manage_export_mrpack(root.detail_instance_name) } }
                            }
                        }
                        MiscCard {
                            title: "Loader-Version";
                            hint: "Aktuell: " + root.manage_loader_current;
                            VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 10px;
                                    loader_combo := ComboBox { model: root.manage_loader_versions; horizontal-stretch: 1; }
                                    SecondaryButton { text: "Prüfen"; button-width: 90px; clicked => { root.manage_loader_check(root.detail_instance_name, loader_combo.current-value) } }
                                    SecondaryButton { text: "Neueste"; button-width: 110px; clicked => { root.manage_loader_latest(root.detail_instance_name) } }
                                }
                                if root.manage_loader_report != "" : Text { text: root.manage_loader_report; color: #e2e8f0; font-size: 12px; wrap: word-wrap; }
                                if root.manage_loader_pending != "" : PrimaryButton {
                                    text: "Wechsel bestätigen (" + root.manage_loader_pending + ")";
                                    width: 100%;
                                    clicked => { root.manage_loader_apply(root.detail_instance_name, root.manage_loader_pending) }
                                }
                            }
                        }
                        MiscCard {
                            title: "Update via .mrpack";
                            hint_height: 52px;
                            hint: "Lokale .mrpack als Update einspielen. Welten bleiben erhalten.";
                            HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                update_file_box := LineEdit { placeholder-text: "/pfad/zur/datei.mrpack"; horizontal-stretch: 1; }
                                PrimaryButton { text: "Update prüfen"; button-width: 140px; clicked => { root.manage_update_from_file(root.detail_instance_name, update_file_box.text) } }
                            }
                        }
                        MiscCard {
                            title: "Modpack-Update";
                            if root.manage_update_supported : HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                update_combo := ComboBox { model: root.manage_update_versions; horizontal-stretch: 1; }
                                SecondaryButton { text: "Prüfen"; button-width: 90px; clicked => { root.manage_update_check(root.detail_instance_name, update_combo.current-index) } }
                            }
                            if root.manage_update_report != "" : Text { text: root.manage_update_report; color: #e2e8f0; font-size: 12px; wrap: word-wrap; }
                            if root.manage_update_pending : PrimaryButton { text: "Update durchführen"; width: 100%; clicked => { root.manage_update_apply(root.detail_instance_name) } }
                        }
                        MiscCard {
                            title: "Desktop-Verknüpfung";
                            SecondaryButton { text: "Verknüpfung erstellen"; button-width: 200px; clicked => { root.create_shortcut(root.detail_instance_name) } }
                        }
                        MiscCard {
                            title: "Löschen";
                            if !root.manage_confirm_delete : DangerButton { text: "Instanz löschen..."; button-width: 170px; clicked => { root.manage_confirm_delete = true } }
                            if root.manage_confirm_delete : HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                Text { text: "Wirklich löschen?"; color: #ef4444; vertical-alignment: center; horizontal-stretch: 1; }
                                DangerButton { text: "Ja, löschen"; button-width: 120px; clicked => { root.manage_delete(root.detail_instance_name) } }
                                SecondaryButton { text: "Abbrechen"; button-width: 100px; clicked => { root.manage_confirm_delete = false } }
                            }
                        }
                        if root.manage_status != "" : Text { text: root.manage_status; color: #10b981; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    if install_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { if (!root.install_popup_installing) { root.install_popup_visible = false; } } }
        Rectangle {
            width: 500px; height: 320px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 16px;
                padding: 24px;
                Text { text: "Version installieren: " + root.install_popup_pack_name; color: #f7fafc; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                install_version_combo := ComboBox { model: root.install_popup_versions; enabled: !root.install_popup_installing; }
                if root.install_popup_status != "" : Text { text: root.install_popup_status; color: #10b981; wrap: word-wrap; horizontal-alignment: center; font-size: 12px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    SecondaryButton { text: "Abbrechen"; enabled: !root.install_popup_installing; clicked => { root.install_popup_visible = false } }
                    PrimaryButton {
                        text: root.install_popup_installing ? "Installiere..." : "Installieren";
                        enabled: !root.install_popup_installing;
                        button-width: 150px;
                        clicked => {
                            root.install_popup_installing = true;
                            root.install_popup_status = "Installation wird gestartet...";
                            root.browser_confirm_install(install_version_combo.current-index);
                        }
                    }
                }
            }
        }
    }

    if add_mod_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.add_mod_popup_visible = false } }
        Rectangle {
            width: 700px; height: 600px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 16px;
                padding: 20px;
                HorizontalLayout {
                    max-height: 40px;
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: #0f1419;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e293b;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            Text { text: "🔍"; color: #64748b; vertical-alignment: center; }
                            add_mod_search_box := LineEdit {
                                placeholder-text: "Mods durchsuchen...";
                                horizontal-stretch: 1;
                                accepted(text) => { root.detail_add_mod_search(text) }
                            }
                        }
                    }
                    SecondaryButton { text: "Suchen"; button-width: 90px; clicked => { root.detail_add_mod_search(add_mod_search_box.text) } }
                    SecondaryButton { text: "Schließen"; button-width: 100px; clicked => { root.add_mod_popup_visible = false } }
                }
                if root.add_mod_status != "" : Text { text: root.add_mod_status; color: #10b981; wrap: word-wrap; horizontal-alignment: center; font-size: 12px; }
                add_mod_scroll := ScrollView {
                    vertical-stretch: 1;
                    property <int> cols: max(1, floor((self.width / 1px) / 296));
                    GridLayout {
                        spacing: 16px;
                        for pack[i] in root.add_mod_results : BrowserTile {
                            row: floor(i / add_mod_scroll.cols);
                            col: mod(i, add_mod_scroll.cols);
                            project_id: pack.project_id;
                            name: pack.name;
                            summary: pack.summary;
                            author: pack.author;
                            icon: pack.icon;
                            source: pack.source;
                            starred: pack.starred;
                            install_clicked(id, n, src) => { root.detail_add_mod_install(root.detail_instance_name, id, n) }
                            toggle_star(id) => { root.toggle_favorite("mods", id) }
                        }
                    }
                }
            }
        }
    }

    if preset_add_mod_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.preset_add_mod_popup_visible = false } }
        Rectangle {
            width: 700px; height: 600px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 16px;
                padding: 20px;
                HorizontalLayout {
                    max-height: 40px;
                    spacing: 10px;
                    Text {
                        text: "Filter: " + (root.preset_new_mc == "" ? "alle" : root.preset_new_mc) + " · " + root.preset_new_loader;
                        color: #10b981;
                        font-size: 12px;
                        height: 16px;
                        vertical-alignment: center;
                    }
                    preset_mod_search_box := LineEdit {
                        placeholder-text: "Mods durchsuchen...";
                        horizontal-stretch: 1;
                        accepted(text) => { root.preset_new_add_mod_search(text) }
                    }
                    SecondaryButton { text: "Suchen"; button-width: 90px; clicked => { root.preset_new_add_mod_search(preset_mod_search_box.text) } }
                    SecondaryButton { text: "Schließen"; button-width: 100px; clicked => { root.preset_add_mod_popup_visible = false } }
                }
                preset_mod_scroll := ScrollView {
                    vertical-stretch: 1;
                    property <int> cols: max(1, floor((self.width / 1px) / 296));
                    GridLayout {
                        spacing: 16px;
                        for pack[i] in root.preset_add_mod_results : BrowserTile {
                            row: floor(i / preset_mod_scroll.cols);
                            col: mod(i, preset_mod_scroll.cols);
                            project_id: pack.project_id;
                            name: pack.name;
                            summary: pack.summary;
                            author: pack.author;
                            icon: pack.icon;
                            source: pack.source;
                            starred: pack.starred;
                            action_text: "Hinzufügen";
                            install_clicked(id, n, src) => { root.preset_new_add_mod(id, n) }
                            toggle_star(id) => { root.toggle_favorite("mods", id) }
                        }
                    }
                }
            }
        }
    }

    if misc_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.misc_popup_visible = false } }
        Rectangle {
            width: 90%; height: 88%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 14px;
                padding: 20px;
                HorizontalLayout {
                    max-height: 32px;
                    spacing: 10px;
                    Text { text: "Misc: " + root.detail_instance_name; color: #f7fafc; font-size: 18px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    SecondaryButton { text: "Schließen"; button-width: 100px; clicked => { root.misc_popup_visible = false } }
                }
                misc_scroll := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 14px;
                        padding: 4px;
                        MiscCard {
                            title: "Zusätzliche JVM-Argumente";
                            hint: "Mit Leerzeichen trennen, z.B. -Xss2M -Dfoo=bar";
                            LineEdit { text <=> root.misc_jvm_args; placeholder-text: "-Xss2M ..."; }
                        }
                        MiscCard {
                            title: "JVM-Preset";
                            hint: root.misc_suggestion;
                            hint_height: 72px;
                            for p in root.misc_presets : Rectangle {
                                height: 160px;
                                background: root.misc_preset_id == p.id ? #2d3748 : #0f1419;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: root.misc_preset_id == p.id ? #3b82f6 : #1e293b;
                                clip: true;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 10px;
                                        Text {
                                            text: p.title + (p.suggested ? "  (Vorschlag)" : "");
                                            color: p.suggested ? #10b981 : #f7fafc;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        SecondaryButton {
                                            text: root.misc_preset_id == p.id ? "Gewählt" : "Wählen";
                                            button-width: 90px;
                                            button-height: 26px;
                                            enabled: root.misc_preset_id != p.id;
                                            clicked => { root.misc_preset_id = p.id }
                                        }
                                    }
                                    Text { text: p.description; wrap: word-wrap; color: #94a3b8; font-size: 12px; height: 72px; vertical-alignment: top; overflow: elide; }
                                    Text { text: p.flags; color: #64748b; font-size: 10px; height: 14px; overflow: elide; }
                                }
                            }
                        }
                        MiscCard {
                            title: "Umgebungsvariablen";
                            for v[i] in root.misc_env_vars : HorizontalLayout {
                                height: 28px;
                                spacing: 10px;
                                Text { text: v.name + " = " + v.value; color: #f7fafc; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                DangerButton { text: "Entfernen"; button-width: 90px; button-height: 26px; clicked => { root.misc_env_remove(root.detail_instance_name, i) } }
                            }
                            HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                env_name_box := LineEdit { placeholder-text: "NAME"; width: 170px; }
                                env_value_box := LineEdit { placeholder-text: "Wert"; horizontal-stretch: 1; }
                                PrimaryButton {
                                    text: "Hinzufügen";
                                    button-width: 110px;
                                    clicked => { root.misc_env_add(root.detail_instance_name, env_name_box.text, env_value_box.text); env_name_box.text = ""; env_value_box.text = ""; }
                                }
                            }
                        }
                        MiscCard {
                            title: "Wrapper-Programme";
                            if root.misc_wrappers.length == 0 : Text { text: "Keine Wrapper verfügbar."; color: #64748b; font-size: 12px; }
                            for w in root.misc_wrappers : VerticalLayout {
                                spacing: 4px;
                                CheckBox {
                                    text: w.label + (w.available ? "" : "  (nicht gefunden)");
                                    checked: w.enabled;
                                    enabled: w.available;
                                    toggled => { root.misc_wrapper_toggle(root.detail_instance_name, w.id, self.checked) }
                                }
                                Text { text: w.hint; color: #64748b; font-size: 11px; wrap: word-wrap; height: 32px; vertical-alignment: top; overflow: elide; }
                            }
                            if root.misc_wrapper_warning != "" : Text { text: root.misc_wrapper_warning; color: #f59e0b; font-size: 12px; wrap: word-wrap; height: 36px; vertical-alignment: top; overflow: elide; }
                        }
                        if root.misc_is_linux : MiscCard {
                            title: "System-GLFW";
                            hint_height: 52px;
                            hint: root.misc_glfw_found ? "Nutzt die System-GLFW statt der mitgelieferten." : "Keine System-GLFW gefunden.";
                            CheckBox { text: "System-GLFW verwenden"; checked <=> root.misc_use_system_glfw; enabled: root.misc_glfw_found; }
                        }
                        MiscCard {
                            title: "Doppelte Mods";
                            hint_height: 52px;
                            hint: "Doppelte Mods erscheinen orange. Automatisches Beheben ist standardmäßig aus.";
                            CheckBox { text: "Automatisches Beheben erlauben"; checked <=> root.misc_auto_fix_dupes; }
                        }
                        MiscCard {
                            title: "Werkzeuge";
                            hint_height: 52px;
                            hint: "Server-Pack oder verwaiste Libraries suchen.";
                            HorizontalLayout {
                                height: 32px;
                                spacing: 10px;
                                alignment: start;
                                SecondaryButton { text: "Server-Pack erstellen"; button-width: 190px; clicked => { root.sp_name = root.detail_instance_name + " Server"; root.sp_popup_visible = true; } }
                                SecondaryButton { text: "Verwaiste Libraries"; button-width: 200px; clicked => { root.orphans_scan(root.detail_instance_name) } }
                            }
                            if root.misc_tools_status != "" : Text { text: root.misc_tools_status; color: #10b981; wrap: word-wrap; font-size: 12px; height: 52px; vertical-alignment: top; overflow: elide; }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            PrimaryButton {
                                text: "Speichern";
                                button-width: 130px;
                                clicked => { root.misc_save(root.detail_instance_name, root.misc_jvm_args, root.misc_preset_id, root.misc_use_system_glfw, root.misc_auto_fix_dupes) }
                            }
                            Text { text: root.misc_status; color: #10b981; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    if compat_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.compat_cancel() } }
        Rectangle {
            width: 600px; height: 500px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 14px;
                padding: 20px;
                if !root.compat_conflict_visible : Text {
                    text: root.compat_mode == "update" ? "Konflikte" : "Vorgeschlagene Änderungen";
                    color: #f7fafc;
                    font-weight: 700;
                    font-size: 18px;
                    horizontal-alignment: center;
                }
                if !root.compat_conflict_visible : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for action in root.compat_actions : Rectangle {
                            height: 36px;
                            background: #0f1419;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #1e293b;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text { text: action.label; color: action.confirmed ? #f7fafc : #64748b; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                                SecondaryButton {
                                    text: root.compat_mode == "update" ? (action.confirmed ? "Neue Datei" : "Meine Datei") : (action.confirmed ? "Bestätigt" : "Übersprungen");
                                    button-width: 120px;
                                    button-height: 26px;
                                    clicked => { root.compat_toggle_action(action.project_id) }
                                }
                            }
                        }
                    }
                }
                if !root.compat_conflict_visible : HorizontalLayout {
                    spacing: 10px;
                    SecondaryButton { text: "Abbrechen"; clicked => { root.compat_cancel() } }
                    PrimaryButton {
                        text: "Übernehmen";
                        button-width: 150px;
                        clicked => {
                            if root.compat_mode == "duplicates" { root.duplicates_apply(root.detail_instance_name) }
                            else if root.compat_mode == "update" { root.update_confirm(root.detail_instance_name) }
                            else { root.compat_apply(root.detail_instance_name) }
                        }
                    }
                }
                if root.compat_conflict_visible : Text { text: "Keine kompatible Kombination gefunden:"; color: #f7fafc; font-weight: 700; horizontal-alignment: center; }
                if root.compat_conflict_visible : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for line in root.compat_conflicts : Text { text: line; color: #ef4444; wrap: word-wrap; font-size: 12px; }
                    }
                }
                if root.compat_conflict_visible : HorizontalLayout {
                    spacing: 10px;
                    SecondaryButton { text: "Abbrechen"; clicked => { root.compat_cancel() } }
                    DangerButton { text: "Betroffene Mods deaktivieren"; button-width: 220px; clicked => { root.compat_disable_conflicts(root.detail_instance_name) } }
                }
            }
        }
    }

    if import_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { if (!root.import_busy) { root.import_popup_visible = false; } } }
        Rectangle {
            width: 600px; height: 320px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 14px;
                padding: 24px;
                Text { text: "Modpack importieren (.mrpack)"; color: #f7fafc; font-weight: 700; horizontal-alignment: center; font-size: 18px; }
                Text { text: "Pfad zur .mrpack-Datei einfügen."; color: #94a3b8; wrap: word-wrap; font-size: 12px; }
                import_path_box := LineEdit { placeholder-text: "/pfad/zur/datei.mrpack"; enabled: !root.import_busy; }
                if root.install_popup_status != "" : Text { text: root.install_popup_status; color: #10b981; wrap: word-wrap; font-size: 12px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    SecondaryButton { text: "Abbrechen"; enabled: !root.import_busy; clicked => { root.import_popup_visible = false; } }
                    PrimaryButton {
                        text: root.import_busy ? "Importiere..." : "Importieren";
                        enabled: !root.import_busy;
                        button-width: 150px;
                        clicked => { root.import_busy = true; root.install_popup_status = "Starte Import..."; root.import_mrpack(import_path_box.text); }
                    }
                }
            }
        }
    }

    if import_cf_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { if (!root.import_cf_busy) { root.import_cf_popup_visible = false; } } }
        Rectangle {
            width: 600px; height: 320px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 14px;
                padding: 24px;
                Text { text: "CurseForge Modpack importieren"; color: #f7fafc; font-weight: 700; horizontal-alignment: center; font-size: 18px; }
                Text { text: "Pfad zur CurseForge .zip-Datei einfügen."; color: #94a3b8; wrap: word-wrap; font-size: 12px; }
                import_cf_path_box := LineEdit { placeholder-text: "/pfad/zum/pack.zip"; enabled: !root.import_cf_busy; }
                if root.install_popup_status != "" : Text { text: root.install_popup_status; color: #10b981; wrap: word-wrap; font-size: 12px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    SecondaryButton { text: "Abbrechen"; enabled: !root.import_cf_busy; clicked => { root.import_cf_popup_visible = false; } }
                    PrimaryButton {
                        text: root.import_cf_busy ? "Importiere..." : "Importieren";
                        enabled: !root.import_cf_busy;
                        button-width: 150px;
                        clicked => { root.import_cf_busy = true; root.install_popup_status = "Starte Import..."; root.import_cf_zip(import_cf_path_box.text); }
                    }
                }
            }
        }
    }

    if ms_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { if (!root.ms_busy) { root.ms_popup_visible = false; } } }
        Rectangle {
            width: 600px; height: 480px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                spacing: 14px;
                padding: 24px;
                Text { text: "Microsoft-Login"; color: #f7fafc; font-weight: 700; horizontal-alignment: center; font-size: 18px; }
                Text { text: "1. Login-Seite öffnen und anmelden.\n2. Leere Seite erscheint – Adresse kopieren.\n3. Adresse unten einfügen."; color: #94a3b8; wrap: word-wrap; font-size: 12px; }
                LineEdit { text: root.ms_login_url; read-only: true; }
                SecondaryButton { text: "Im Browser öffnen"; button-width: 180px; clicked => { root.account_microsoft_open_browser(); } }
                ms_code_box := LineEdit { placeholder-text: "Adresse oder Code einfügen..."; enabled: !root.ms_busy; }
                if root.ms_status != "" : Text { text: root.ms_status; color: #10b981; wrap: word-wrap; font-size: 12px; }
                HorizontalLayout {
                    spacing: 10px;
                    SecondaryButton { text: "Abbrechen"; enabled: !root.ms_busy; clicked => { root.ms_popup_visible = false; } }
                    PrimaryButton {
                        text: root.ms_busy ? "Melde an..." : "Anmelden";
                        enabled: !root.ms_busy;
                        button-width: 140px;
                        clicked => { root.account_microsoft_submit(ms_code_box.text); }
                    }
                }
            }
        }
    }

    if console_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.console_close(); } }
        Rectangle {
            width: 80%; height: 70%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #0f1419;
            border-radius: 14px;
            border-width: 1px;
            border-color: #1e293b;
            TouchArea {}
            VerticalLayout {
                spacing: 10px;
                padding: 16px;
                HorizontalLayout {
                    max-height: 34px;
                    spacing: 10px;
                    Text { text: "Live Console: " + root.console_instance_name; color: #10b981; font-weight: 700; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: root.console_auto_scroll ? "Auto-Scroll: AN" : "Auto-Scroll: AUS"; color: root.console_auto_scroll ? #10b981 : #f59e0b; font-size: 11px; vertical-alignment: center; }
                    SecondaryButton { text: root.console_auto_scroll ? "Auto aus" : "Auto an"; button-width: 120px; clicked => { root.console_auto_scroll = !root.console_auto_scroll; } }
                    SecondaryButton { text: "Schließen"; button-width: 100px; clicked => { root.console_close(); } }
                }
                console_scroll := ScrollView {
                    vertical-stretch: 1;
                    property <int> observe_tick: root.console_scroll_tick;
                    property <length> observe_viewport: self.content-y;
                    changed observe_tick => { if (root.console_auto_scroll) { self.content-y = 1000000px; } }
                    changed observe_viewport => {
                        let at_bottom = self.content-y >= self.content-height - self.height - 10px;
                        if (!at_bottom) { root.console_auto_scroll = false; } else { root.console_auto_scroll = true; }
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 1px;
                        if root.console_lines.length == 0 : Text { text: "(Noch keine Log-Ausgabe.)"; color: #64748b; font-size: 11px; }
                        for line in root.console_lines : Text { text: line; color: #e2e8f0; font-size: 11px; wrap: no-wrap; }
                    }
                }
            }
        }
    }

    if recache_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { }
        Rectangle {
            width: 520px; height: 180px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: "Icon-Cache wird neu erstellt"; color: #f7fafc; font-weight: 700; font-size: 17px; horizontal-alignment: center; }
                Text { text: root.recache_status; color: #10b981; wrap: word-wrap; horizontal-alignment: center; font-size: 12px; height: 40px; }
                Rectangle { height: 20px; background: #0f1419; border-radius: 6px;
                    Rectangle { width: parent.width * root.recache_progress; height: 100%; background: #10b981; border-radius: 6px; animate width { duration: 200ms; easing: ease-in-out; } }
                }
            }
        }
    }

    if sp_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.sp_popup_visible = false; } }
        Rectangle {
            width: 540px; height: 300px;
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: "Server-Pack erstellen"; color: #f7fafc; font-weight: 700; font-size: 17px; horizontal-alignment: center; }
                Text { text: "Das Pack wird als .zip in den Downloads-Ordner gelegt."; color: #94a3b8; font-size: 12px; wrap: word-wrap; height: 34px; }
                CheckBox { text: "Zusätzlich als Server hinzufügen"; checked <=> root.sp_add; }
                if root.sp_add : LineEdit { placeholder-text: "Name des Servers"; text <=> root.sp_name; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    SecondaryButton { text: "Abbrechen"; clicked => { root.sp_popup_visible = false; } }
                    PrimaryButton { text: "Erstellen"; button-width: 130px; clicked => { root.sp_popup_visible = false; root.server_pack_export(root.detail_instance_name, root.sp_add, root.sp_name); } }
                }
            }
        }
    }

    if crash_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #000000cc;
        TouchArea { clicked => { root.crash_popup_visible = false; } }
        Rectangle {
            width: 70%; height: 80%;
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            background: #1a202c;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2d3748;
            TouchArea {}
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    max-height: 32px;
                    spacing: 10px;
                    Text { text: "Absturz-Analyse: " + root.crash_instance; color: #f7fafc; font-size: 17px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    SecondaryButton { text: "Schließen"; button-width: 100px; clicked => { root.crash_popup_visible = false; } }
                }
                Text { text: root.crash_summary; color: #f59e0b; font-size: 12px; wrap: word-wrap; height: 34px; vertical-alignment: top; overflow: elide; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;
                        for f in root.crash_findings : Rectangle {
                            height: 240px;
                            background: #0f1419;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #1e293b;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: f.title; color: #f59e0b; font-weight: 700; font-size: 14px; height: 20px; overflow: elide; }
                                Text { text: f.explanation; color: #f7fafc; font-size: 12px; wrap: word-wrap; height: 70px; vertical-alignment: top; overflow: elide; }
                                Text { text: "Lösung: " + f.suggestion; color: #10b981; font-size: 12px; wrap: word-wrap; height: 70px; vertical-alignment: top; overflow: elide; }
                                if f.mod_file != "" : HorizontalLayout {
                                    height: 30px;
                                    spacing: 10px;
                                    Text { text: "Verdächtig: " + f.mod_file; color: #a78bfa; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    DangerButton { text: "Deaktivieren"; button-width: 120px; button-height: 28px; clicked => { root.crash_disable_mod(root.crash_instance, f.mod_file); } }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 32px;
                    spacing: 10px;
                    Text { text: root.crash_status; color: #10b981; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    SecondaryButton { text: "Report / Log öffnen"; button-width: 180px; clicked => { root.crash_open_report(root.crash_instance); } }
                }
            }
        }
    }

    if root.launch_popup_visible : LaunchOverlay {
        width: 100%; height: 100%;
        instance: root.launch_instance;
        status: root.launch_status;
        progress: root.launch_progress;
    }

    if root.debug_ui : Rectangle {
        y: parent.height - 150px;
        width: 100%;
        height: 150px;
        background: #000000ee;
        VerticalLayout {
            padding: 8px;
            Text { text: "Debug Log"; color: #10b981; font-weight: 700; font-size: 12px; }
            ScrollView {
                VerticalLayout {
                    for line in root.debug_log : Text { text: line; color: #e2e8f0; font-size: 10px; }
                }
            }
        }
    }
}