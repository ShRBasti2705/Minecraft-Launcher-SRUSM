struct AchievementUi {
    title: string,
    title_big: string,     // GROSS geschrieben, für die Karten
    description: string,
    kind: string,          // "advancement" | "goal" | "challenge" | "achievement"
    meta: string,          // Instanz · Welt/Server · MC-Version · Zeit
    short: string,         // Zeit (für die Listenzeilen)
    line: string,          // "Welt/Server - Achievement" (für die Listenzeilen)
    header: string,        // nur in der ersten Zeile einer Gruppe gefüllt, mit Pfeil
    instance: string,      // Instanzname (für das Ein-/Ausklappen)
    collapsed: bool,       // Gruppe eingeklappt?
    icon: image,
    is_new: bool,
}

// Ein-/ausklappbare Leiste am unteren Fensterrand mit den laufenden Instanzen.
// Sie schiebt den Inhalt darüber nach oben (siehe AppWindow), statt ihn zu überdecken.
component RunningBar inherits Rectangle {
    in property <[RunningInstance]> instances;
    in-out property <bool> expanded: false;
    callback force_stop(string); // Instanzname
    callback open_console(string); // öffnet die Live-Konsole einer Instanz

    // Höhe der Liste: pro Zeile 32px, mindestens Platz für den Leer-Text, maximal 150px (dann scrollt sie)
    property <length> list_height: min(150px, max(40px, root.instances.length * 32px + 8px));

    height: root.expanded ? 30px + root.list_height : 30px;
    background: #1b2330;
    clip: true;
    animate height { duration: 150ms; easing: ease-in-out; }

    VerticalLayout {
        alignment: start;

        // Kopfzeile: Klick klappt die Leiste ein/aus
        Rectangle {
            height: 30px;
            background: #232c3a;

            TouchArea { clicked => { root.expanded = !root.expanded; } }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text { text: root.expanded ? "▼" : "▲"; color: #a0a8b5; vertical-alignment: center; font-size: 11px; }
                Text {
                    text: "Laufende Instanzen (" + root.instances.length + ")";
                    color: white;
                    vertical-alignment: center;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }
            }
        }

        if root.expanded : ScrollView {
            height: root.list_height;

            VerticalLayout {
                alignment: start;
                spacing: 4px;
                padding: 4px;
                padding-left: 12px;
                padding-right: 12px;

                if root.instances.length == 0 : Text {
                    text: "Keine Instanz läuft.";
                    color: #7a8291;
                    font-size: 12px;
                }

                for inst in root.instances : HorizontalLayout {
                    height: 28px;
                    spacing: 10px;

                    Text {
                        text: inst.name;
                        color: white;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    // NEU: Console-Button (blau), links vom Force-Stop
                    Rectangle {
                        width: 80px;
                        height: 24px;
                        border-radius: 4px;
                        background: console_area.pressed ? #203050 : (console_area.has-hover ? #4a6090 : #3a5070);

                        console_area := TouchArea { clicked => { root.open_console(inst.name); } }

                        Text {
                            text: "Console";
                            color: white;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Eigener roter Button (der Standard-Button lässt sich nicht einfärben), ganz rechts
                    Rectangle {
                        width: 90px;
                        height: 24px;
                        border-radius: 4px;
                        background: stop_area.pressed ? #a02020 : (stop_area.has-hover ? #e04040 : #c93030);

                        stop_area := TouchArea { clicked => { root.force_stop(inst.name); } }

                        Text {
                            text: "Force Stop";
                            color: white;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Rahmen für eine Karte im Misc-Popup: Titel, optionaler Hinweistext, darunter beliebiger Inhalt.
// Rahmen für eine Karte im Misc-Popup: Titel, optionaler Hinweistext, darunter beliebiger Inhalt.
// hint_height ist fest, weil Slint die Höhe von umbrochenem Text in Layouts nicht
// breitenabhängig berechnet (sonst überlappen Karten bei schmalen Fenstern).
component MiscCard inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <length> hint_height: 34px; // ca. 2 Zeilen; bei langen Hints pro Karte erhöhen
    background: #232c3a;
    border-radius: 6px;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text { text: root.title; color: white; font-weight: 700; font-size: 14px; }
        if root.hint != "" : Text {
            text: root.hint;
            color: #a0a8b5;
            font-size: 12px;
            wrap: word-wrap;
            height: root.hint_height;
            vertical-alignment: top;
            overflow: elide;
        }
        @children
    }
}

component AchievementCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> meta;
    in property <string> kind;
    in property <image> icon;
    in property <bool> is_new: false;

    height: 84px;
    background: #232c3a;
    border-radius: 8px;
    border-width: 2px;
    border-color: root.is_new ? #1bd96a : #2c3747;

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;

        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 8px;
            background: #1b2330;

            Text {
                text: root.kind == "challenge" ? "★" : (root.kind == "goal" ? "◆" : "●");
                color: root.kind == "challenge" ? #c792ea : (root.kind == "goal" ? #4da3ff : #7bdc8a);
                font-size: 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Image {
                source: root.icon;
                width: 40px;
                height: 40px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; color: root.is_new ? #7bdc8a : white; font-size: 16px; font-weight: 800; overflow: elide; height: 22px; }
            Text { text: root.description; color: #a0a8b5; font-size: 12px; overflow: elide; height: 18px; }
            Text { text: root.meta; color: #7a8291; font-size: 10px; overflow: elide; height: 14px; }
        }
    }
}

// Vollbild-Overlay beim Spielstart: Karte mit hüpfenden Blöcken, großem Status-Text
// und animierter Loading-Bar. Die Animation läuft über einen Timer (t zählt hoch),
// weil das in jeder Slint-Version zuverlässig funktioniert.
// Die Komponente wird nur per "if" erzeugt, t startet also bei jedem Start bei 0.
component LaunchOverlay inherits Rectangle {
    in property <string> instance;
    in property <string> status;
    in property <float> progress;
    in-out property <int> t: 0;

    // 0 -> 1 in ca. 0,3 s: für das Einblenden und Hochgleiten der Karte
    property <float> appear: min(1.0, root.t / 10.0);

    background: #000000cc;
    opacity: root.appear;

    Timer {
        interval: 30ms;
        running: true;
        triggered => { root.t += 1; }
    }

    TouchArea {} // blockt Klicks auf alles dahinter

    Rectangle {
        width: min(620px, parent.width - 40px);
        height: 340px;
        x: parent.width / 2 - self.width / 2;
        y: parent.height / 2 - self.height / 2 + (1.0 - root.appear) * 30px;
        background: #1f2937;
        border-radius: 16px;
        drop-shadow-blur: 30px;
        drop-shadow-color: #000000aa;

        VerticalLayout {
            padding: 28px;
            spacing: 14px;

            Text {
                text: "Starte " + root.instance;
                color: #a0a8b5;
                font-size: 14px;
                horizontal-alignment: center;
                overflow: elide;
                height: 20px;
            }

            // Drei hüpfende Blöcke (grün / blau / orange), jeder leicht phasenversetzt
            Rectangle {
                height: 48px;
                for i in 3 : Rectangle {
                    x: parent.width / 2 - 33px + i * 26px;
                    y: 28px - 24px * max(0.0, sin(root.t * 14deg - i * 50deg));
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    background: i == 0 ? #1bd96a : (i == 1 ? #4da3ff : #ff9a2e);
                }
            }

            // Der große Status-Text: sagt, was gerade passiert
            Text {
                text: root.status;
                color: white;
                font-size: 26px;
                font-weight: 800;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
                overflow: elide;
            }

            // Loading-Bar mit Farbverlauf + Glanz, der über den gefüllten Teil wandert
            Rectangle {
                height: 18px;
                border-radius: 9px;
                background: #0f1520;
                clip: true;

                Rectangle {
                    width: max(18px, parent.width * root.progress);
                    height: parent.height;
                    border-radius: 9px;
                    background: @linear-gradient(90deg, #1bd96a 0%, #4da3ff 100%);
                    clip: true;
                    animate width { duration: 400ms; easing: ease-out; }

                    Rectangle {
                        width: 70px;
                        height: parent.height;
                        x: (mod(root.t * 5.0, parent.width / 1px + 70.0) - 70.0) * 1px;
                        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff55 50%, #ffffff00 100%);
                    }
                }
            }

            Text {
                text: round(root.progress * 100) + " %";
                color: #7a8291;
                font-size: 12px;
                horizontal-alignment: center;
                height: 16px;
            }
        }
    }
}

export component AppWindow inherits Window {

    // Callbacks
    callback modpack_play(string);
    callback create_and_run(string, string, string);
    callback browser_search(string, string); // query, source
    callback save_settings(int, string, string, bool, bool, bool, int, bool);
    callback apply_device_tier(string, bool); // choice, auch Icons recachen?
    callback browser_open_install(string, string, string); // project_id, pack_name, source <-- GEÄNDERT
    callback browser_confirm_install(int);
    callback import_mrpack(string);
    callback import_cf_zip(string); // <-- NEU: Für den .zip Import

    // Feature 6: Favoriten toggeln. kind = "instances" | "modpacks" | "mods"
    callback toggle_favorite(string, string);

    callback compat_toggle_action(string);
    callback compat_apply(string); // instance_name
    callback compat_disable_conflicts(string); // instance_name
    callback compat_cancel();

    // Detail-Ansicht einer einzelnen Instanz
    callback open_instance_details(string); // instance_name -> lädt Mods + Overrides, wechselt Panel
    callback detail_toggle_mod(string, string); // instance_name, filename -> enable/disable
    callback detail_remove_mod(string, string); // instance_name, filename
    callback detail_save_overrides(string, bool, int, string, string, int, int, bool); // instance_name, enabled, ram, java_path, username
    callback detail_open_folder(string); // instance_name -> öffnet den Instanz-Ordner im Dateimanager
    callback detail_add_mod_search(string); // Suchtext im Add-Mod-Popup
    callback detail_add_mod_install(string, string, string); // instance_name, project_id, project_name -> lädt passende Version direkt in mods/

    // Account-Verwaltung
    callback account_add_offline(string); // username
    callback account_add_microsoft(); // aktuell nur Status-Meldung, siehe main.rs
    callback account_select(string); // account id
    callback account_remove(string); // account id
    callback account_microsoft_open_browser();
    callback account_microsoft_submit(string); // eingefügte Adresse bzw. Code
    callback force_stop(string); // instance_name -> beendet den laufenden Prozess
    callback console_open(string); // Live-Konsole für eine Instanz öffnen
    callback console_close();      // Live-Konsole schließen

    // Spielzeit: "pure" = reine Abfrage. Das int-Argument (playtime_tick) erzwingt die Neuberechnung nach einer Session.
    pure callback instance_playtime(string, int) -> string;
    // Misc-Popup (Block 2)
    callback misc_open(string);                               // instance -> lädt alles und öffnet das Popup
    callback misc_save(string, string, string, bool, bool);   // instance, jvm_args, preset_id, use_system_glfw, auto_fix_duplicates
    callback misc_env_add(string, string, string);            // instance, name, value
    callback misc_env_remove(string, int);                    // instance, index
    callback misc_wrapper_toggle(string, string, bool);       // instance, wrapper_id, enabled
    callback world_play(string, string);    // instance_name, folder_name
    callback server_join(string, string);   // instance_name, server_ip
    callback refresh_servers(string);       // instance_name -> Ping alle Server
    callback detail_filter_mods(string, string);              // instance, suchtext
    // Manage Instanz (Block 3)
    callback manage_open(string);
    callback manage_duplicate(string, string);                // instance, neuer Name
    callback manage_rename(string, string);                   // instance, neuer Name
    callback manage_export(string);
    callback manage_delete(string);
    callback manage_loader_check(string, string);             // instance, Ziel-Version -> Resolver-Test, dann Bestätigung
    callback create_shortcut(string);
    // Presets (Neue Features 3)
    callback preset_new_start();
    callback preset_new_set_mc(string);
    callback preset_new_set_loader(string);
    callback preset_new_add_mod_search(string);
    callback preset_new_add_mod(string, string);
    callback preset_new_remove_mod(string);
    callback preset_new_save();
    callback preset_select(string);
    callback preset_delete(string);
    callback preset_apply(string, string); // preset_id, instance_name
    callback manage_loader_latest(string);
    // Features: Update, Exporte, Werkzeuge, Statistik
    callback manage_update_load(string);        // instance -> Versionsliste laden
    callback manage_update_check(string, int);  // instance, Index der gewählten Version
    callback manage_update_apply(string);       // instance
    callback manage_update_from_file(string, string); // instance, Pfad zur .mrpack
    callback update_confirm(string);            // instance (Konflikt-Popup im Modus "update")
    callback manage_export_mrpack(string);
    callback server_pack_export(string, bool, string); // instance, als Server hinzufügen?, Servername
    callback orphans_scan(string);
    callback stats_open();

        // ---- Absturz-Analyse ----
    callback crash_analyze(string);                 // instance
    callback crash_disable_mod(string, string);     // instance, Dateiname
    callback crash_open_report(string);             // instance
    in-out property <bool> crash_popup_visible: false;
    in-out property <string> crash_instance: "";
    in-out property <string> crash_summary: "";
    in-out property <string> crash_status: "";
    in property <[CrashFindingUi]> crash_findings;

    // ---- Server-Pack-Popup (fragt vor dem Export) ----
    in-out property <bool> sp_popup_visible: false;
    in-out property <bool> sp_add: true;
    in-out property <string> sp_name: "";

    // ---- Server-Tab ----
    callback srv_open();
    callback srv_select(string);
    callback srv_create(string, string, string);    // name, mc-version, loader
    callback srv_start(string);
    callback srv_stop(string);
    callback srv_kill(string);
    callback srv_command(string, string);           // server, befehl
    callback srv_save(string, int, bool, string, string, string, string, bool, bool); // name, ram_mb, eula, port, max, motd, difficulty, whitelist, online
    callback srv_delete(string);
    callback srv_open_folder(string);
    in property <[LocalServerUi]> srv_list;
    in-out property <string> srv_selected: "";
    in-out property <string> srv_status: "";
    in-out property <float> srv_ram_gb: 2;
    in-out property <bool> srv_eula: false;
    in-out property <string> srv_prop_port: "25565";
    in-out property <string> srv_prop_max: "20";
    in-out property <string> srv_prop_motd: "";
    in-out property <string> srv_prop_difficulty: "normal";
    in-out property <bool> srv_prop_whitelist: false;
    in-out property <bool> srv_prop_online: true;
    in property <[string]> srv_console_lines;
    in-out property <int> srv_console_tick: 0;
    in-out property <bool> srv_autoscroll: true;
    in-out property <bool> srv_confirm_delete: false;

    in property <[string]> manage_update_versions;
    in-out property <bool> manage_update_supported: false;
    in-out property <bool> manage_update_pending: false;
    in-out property <string> manage_update_report: "";
    in-out property <string> misc_tools_status: "";
    in property <string> stats_summary;
    in property <[StatRowUi]> stats_instances;
    in property <[StatRowUi]> stats_days;
    in property <[StatRowUi]> stats_startups;
    // Doppelte Mods (Block 4)
    callback duplicates_fix(string);
    callback duplicates_apply(string);               // instance -> bestätigte Vorschläge anwenden
    in-out property <string> compat_mode: "mods";    // "mods" oder "duplicates": das Kompatibilitäts-Popup dient beiden
    in-out property <string> dup_status: "";
    // Anzahl doppelter Mods, aus der ersten Zeile der Liste gelesen (siehe dup_total in ModFileInfo)
    property <int> dup_total: root.detail_mod_files.length > 0 ? root.detail_mod_files[0].dup_total : 0;

    // Vars
    in-out property <bool> popup_new_instance: false;
    in-out property <string> selected_panel: "Instanzen";
    in property <[PresetUi]> presets_list;
    in-out property <string> presets_status: "";
    in-out property <string> preset_new_name: "";
    in-out property <string> preset_new_mc: "";
    in-out property <string> preset_new_loader: "fabric";
    in-out property <string> preset_new_loader_version: "";
    in property <[PresetModUi]> preset_new_mods;
    in-out property <bool> preset_add_mod_popup_visible: false;
    in property <[BrowserPackInfo]> preset_add_mod_results;
    in-out property <string> preset_selected_id: "";
    in-out property <string> preset_apply_instance: "";
    in property <[ModpackInfo]> preset_apply_targets;
    in property <[string]> preset_apply_targets_names;
    in property <[ModpackInfo]> packs;
    in property <[string]> mcVersions;
    in property <[BrowserPackInfo]> browser_packs; // Ergebnisse der Modrinth-Suche

    // Settings-Werte, werden beim Start aus settings.json befüllt (siehe main.rs)
    in-out property <int> default_ram_mb: 2048;
    in-out property <string> java_path: "";
    in-out property <string> default_username: "TestUser";
    in-out property <bool> close_after_launch: false;
    in-out property <bool> open_on_startup: false;
    in-out property <bool> show_snapshots: false;

    // Install-Popup State (Version wählen für ein Pack aus dem Browser)
    in-out property <bool> install_popup_visible: false;
    in-out property <string> install_popup_pack_name: "";
    in property <[string]> install_popup_versions; // Labels, z.B. "1.2.0 (1.21.1)"
    in-out property <bool> install_popup_installing: false; // blockt Buttons während des Downloads
    in-out property <string> install_popup_status: ""; // Fortschritts- oder Fehlertext
    in-out property <bool> compat_popup_visible: false;
    in property <[CompatibilityActionUi]> compat_actions;
    in-out property <bool> compat_conflict_visible: false;
    in property <[string]> compat_conflicts;
    in-out property <bool> import_popup_visible: false;
    in-out property <bool> import_busy: false;
    
    // <-- NEU: State für den CurseForge Import Dialog
    in-out property <bool> import_cf_popup_visible: false;
    in-out property <bool> import_cf_busy: false;

    // Instanz-Detailansicht State
    in-out property <string> detail_instance_name: "";
    in-out property <image> detail_instance_icon;
    in property <[ModFileInfo]> detail_mod_files;
    in-out property <bool> detail_overrides_enabled: false;
    in-out property <int> detail_ram_mb: 2048;
    in-out property <string> detail_java_path: "";
    in-out property <string> detail_username: "";

    // Add-Mod-Popup State (innerhalb der Detailansicht)
    in-out property <bool> add_mod_popup_visible: false;
    in property <[BrowserPackInfo]> add_mod_results;
    in-out property <string> add_mod_status: "";

    // Misc-Popup (Detailansicht): viele kleine Extras/Einstellungen in einer horizontal scrollbaren Reihe
    in-out property <bool> misc_popup_visible: false;

    // Account-Verwaltung State
    in property <[AccountInfo]> accounts;
    in-out property <string> accounts_status: "";
    in-out property <bool> ms_popup_visible: false;
    in property <string> ms_login_url: "";
    in-out property <bool> ms_busy: false;
    in-out property <string> ms_status: "";

    // Anzeige-Einstellungen
    in-out property <int> items_per_page: 12;
    in-out property <bool> debug_ui: false;
    in-out property <string> settings_device_tier: "auto";
    in-out property <bool> recache_popup_visible: false;
    in-out property <string> recache_status: "";
    in-out property <float> recache_progress: 0.0;
    in property <[string]> debug_log;
    // Laufende Instanzen (von Rust befüllt) + Zustand der unteren Leiste
    in property <[RunningInstance]> running_instances;
    in-out property <bool> running_bar_expanded: false;

    // Live-Konsole
    in-out property <bool> console_popup_visible: false;
    in-out property <string> console_instance_name: "";
    in property <[string]> console_lines;
    in-out property <bool> console_auto_scroll: true;
    in-out property <int> console_scroll_tick: 0;

    in-out property <int> playtime_tick: 0;

    callback achievements_open();
    callback achievements_toggle(string); // Instanzname -> Gruppe ein-/ausklappen
    in property <[AchievementUi]> achievements_recent;
    in property <[AchievementUi]> achievements_all;
    in property <string> achievements_summary: "";

    // Start-Popup (Rust steuert Sichtbarkeit, Text und Fortschritt)
    in-out property <bool> launch_popup_visible: false;
    in-out property <string> launch_instance: "";
    in-out property <string> launch_status: "";
    in-out property <float> launch_progress: 0.0;

    in-out property <string> mod_filter: "";
    // Misc
    in-out property <string> misc_jvm_args: "";
    in-out property <string> misc_preset_id: "none";
    in property <[JvmPresetUi]> misc_presets;
    in property <string> misc_suggestion: "";
    in property <[EnvVarUi]> misc_env_vars;
    in property <[WrapperUi]> misc_wrappers;
    in property <string> misc_wrapper_warning: "";
    in property <bool> misc_is_linux: false;
    in property <bool> misc_glfw_found: false;
    in-out property <bool> misc_use_system_glfw: true;
    in-out property <bool> misc_auto_fix_dupes: false;
    in-out property <string> misc_status: "";
    // Quick-Connect (Detailansicht)
    // Feature 14: Welten + Server statt Quick-Connect
    in property <[WorldInfoUi]> detail_worlds;
    in property <[ServerInfoUi]> detail_servers;
    in-out property <string> detail_worlds_status: "";
    in-out property <string> detail_servers_status: "";
    // Doppelte Mods + Manage Instanz
    in property <[DuplicateUi]> detail_duplicates;
    in-out property <bool> manage_popup_visible: false;
    in-out property <string> manage_status: "";
    in property <[string]> manage_loader_versions;
    in-out property <string> manage_loader_current: "";
    // Ergänzungen zu Block 1 (die dort deklarierten Namen bleiben unverändert)
    callback manage_loader_apply(string, string);   // instance, bestätigte Version
    in property <string> manage_loader_pending: ""; // Version, die nach erfolgreichem Check bestätigt werden kann
    in property <string> manage_loader_report: "";  // Ergebnistext des Checks
    in-out property <bool> manage_confirm_delete: false;

    // NEU: Aktuelle Quelle im Browser (Standard ist Modrinth)
    in-out property <string> browser_source: "Modrinth";

    // NEU: Für die Dropdowns und erweiterten Settings
    in property <[string]> available_java_paths;
    in property <[string]> available_accounts; // z.B. ["Launcher Standard", "Basti (Microsoft)", "TestUser"]
    in-out property <string> detail_ram_unit: "GB"; // "MB" oder "GB"
    in-out property <string> detail_java_selection: "Launcher Standard";
    in-out property <string> detail_account_selection: "Launcher Standard";
    in-out property <int> detail_window_width: 854;
    in-out property <int> detail_window_height: 480;
    in-out property <bool> detail_fullscreen: false;

    // Global Style
    background: #313e50;
    min-width: 800px;
    min-height: 800px;
    preferred-width: 1100px;  // Startgröße, gern anpassen
    preferred-height: 800px;

    GridLayout {
        y: 0px;
        height: parent.height - running_bar.height; // <-- statt 100%: Platz für die untere Leiste lassen
        width: 100%;

        HorizontalLayout {
            height: 100%;

            Rectangle { // Sidebar-Hintergrund: eigene Rectangle, da Layouts selbst keine background-Property haben
                width: 140px; // fest, sonst wird bei breitem Inhalt rechts mitgestreckt
                height: 100%; // geht immer von ganz oben nach ganz unten, unabhängig vom Panel-Inhalt rechts
                horizontal-stretch: 0; // nimmt sich keinen zusätzlichen Platz
                background: #232c3a; // dunkler als der Fenster-Hintergrund, dezente Abstufung im gleichen Farbschema

                VerticalLayout { // Selected Section
                    height: 100%;
                    spacing: 4px;
                    padding: 8px;

                    TouchArea {
                        width: 100%;
                        height: 50px; // etwas höher, damit zweizeiliger Text (z.B. "Modpack Browser") reinpasst
                        clicked => { root.selected_panel = "Instanzen" }
                        Text {
                            text: "Instanzen";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: (root.selected_panel == "Instanzen" || root.selected_panel == "Instance Detail") ? red : white;
                        }
                    }
                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => {
                            root.selected_panel = "Modpack Browser";
                            // Beim ersten Öffnen direkt mit leerem Query laden, damit nicht erst gesucht werden muss
                            root.browser_search("", root.browser_source); // <-- GEÄNDERT
                        }
                        Text {
                            text: "Modpack Browser";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: root.selected_panel == "Modpack Browser" ? red : white;
                        }
                    }

                    
                                        TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => {
                            root.selected_panel = "Presets";
                            root.preset_new_start();
                        }
                        Text {
                            text: "Presets";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: root.selected_panel == "Presets" ? red : white;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => {
                            root.selected_panel = "Server";
                            root.srv_open();
                        }
                        Text {
                            text: "Server";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            color: root.selected_panel == "Server" ? red : white;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => {
                            root.selected_panel = "Statistik";
                            root.stats_open();
                        }
                        Text {
                            text: "Statistik";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            color: root.selected_panel == "Statistik" ? red : white;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => {
                            root.selected_panel = "Achievements";
                            root.achievements_open();
                        }
                        Text {
                            text: "Achievements";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: root.selected_panel == "Achievements" ? red : white;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => { root.selected_panel = "Accounts" }
                        Text {
                            text: "Accounts";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: root.selected_panel == "Accounts" ? red : white;
                        }
                    }
                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => { root.selected_panel = "Settings" }
                        Text {
                            text: "Settings";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: root.selected_panel == "Settings" ? red : white;
                        }
                    }

                    Rectangle { vertical-stretch: 1; } // Rest-Platz nach unten, damit die Buttons oben bleiben statt sich zu verteilen
                }
            }
            GridLayout { // Panel
                height: 100%;
                horizontal-stretch: 1; // nimmt sich den kompletten Rest-Platz neben der Sidebar

                if selected_panel == "Instanzen" : VerticalLayout {
                    HorizontalLayout { // Steuer Elemente
                        max-height: 40px;
                        spacing: 10px;
                        alignment: start; // Buttons behalten ihre Breite

                        Button {
                            text: "New Instance";
                            primary: true;
                            width: 140px;
                            clicked => {root.popup-new-instance = true}
                        }
                        Button {
                            text: "Modpack importieren (.mrpack)";
                            width: 240px;
                            clicked => {
                                root.install_popup_status = ""; // alten Status vom letzten Install/Import leeren
                                root.import_popup_visible = true;
                            }
                        }
                        Button {
                            text: "CurseForge importieren (.zip)";
                            width: 220px;
                            clicked => {
                                root.install_popup_status = "";
                                root.import_cf_popup_visible = true;
                            }
                        }
                    }

                    instances_scroll := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: max(1, floor(((self.width / 1px) - 20) / 140)); // 120px Breite + 20px Spacing

                        GridLayout {
                            spacing: 20px;
                            padding: 20px;

                            for pack[i] in root.packs : ModpackTile {
                                row: floor(i / instances_scroll.cols);
                                col: mod(i, instances_scroll.cols);
                                name: pack.name;
                                playtime: root.instance_playtime(pack.name, root.playtime_tick);
                                icon: pack.icon;
                                starred: pack.starred;
                                background: #333;
                                modpack_play(n) => { root.modpack_play(n) }
                                modpack_details(n) => { root.open_instance_details(n) }
                                toggle_star(n) => { root.toggle_favorite("instances", n) }
                            }
                        }
                    }

                    //GridLayout { // Installierte Modpacks
                    //    //Background Color change?                        
                    //    spacing: 20px;
                    //    padding: 20px;
                    //
                    //    for pack[i] in root.packs : ModpackTile {
                    //        name: pack.name;
                    //        icon: pack.icon;
                    //        row: floor(i / 3);
                    //        col: mod(i, 3);
                    //        background: #333;
                    //        modpack_play(n) => { root.modpack_play(n) }
                    //        modpack_details(n) => { root.open_instance_details(n) }
                    //    }
                    //
                    //}
                }

                if selected_panel == "Modpack Browser" : VerticalLayout {
                    padding: 20px;
                    spacing: 20px;

                    HorizontalLayout { // Suchleiste
                        max-height: 40px;
                        spacing: 10px;

                        browser_search_box := LineEdit {
                            placeholder-text: "Modpacks durchsuchen...";
                            accepted(text) => { root.browser_search(text, root.browser_source) } // <-- GEÄNDERT
                        }
                        Button {
                            text: "Suchen";
                            width: 80px;
                            clicked => { root.browser_search(browser_search_box.text, root.browser_source) } // <-- GEÄNDERT
                        }
                    }

                    browser_scroll := ScrollView {
                        vertical-stretch: 1;
                        property <int> cols: max(1, floor(((self.width / 1px) - 16) / 276)); // 260px Breite + 16px Spacing

                        GridLayout {
                            spacing: 16px;

                            for pack[i] in root.browser_packs : BrowserTile {
                                row: floor(i / browser_scroll.cols);
                                col: mod(i, browser_scroll.cols);
                                project_id: pack.project_id;
                                name: pack.name;
                                summary: pack.summary;
                                author: pack.author;
                                icon: pack.icon;
                                source: pack.source;
                                starred: pack.starred;
                                install_clicked(id, n, src) => { root.browser_open_install(id, n, src) }
                                toggle_star(id) => { root.toggle_favorite("modpacks", id) }
                            }
                        }
                    }

                    //GridLayout { // Ergebnis-Grid, kommt aus browser_packs (Modrinth)
                    //    spacing: 16px;
                    //
                    //    for pack[i] in root.browser_packs : BrowserTile {
                    //        row: floor(i / 3);
                    //        col: mod(i, 3);
                    //        project_id: pack.project_id;
                    //        name: pack.name;
                    //        summary: pack.summary;
                    //        author: pack.author;
                    //        icon: pack.icon;
                    //        install_clicked(id, n) => { root.browser_open_install(id, n) }
                    //    }
                    //}

                    //Rectangle { vertical-stretch: 1; } // Rest-Platz nach unten
                }

                if selected_panel == "Settings" : VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    alignment: start;

                    Text { text: "Allgemein"; font-size: 18px; font-weight: 700; color: white; }

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Standard-RAM (MB)"; color: white; vertical-alignment: center; width: 180px; }
                        ram_slider := Slider {
                            minimum: 1024;
                            maximum: 16384;
                            value: root.default_ram_mb;
                        }
                        Text { text: round(ram_slider.value) + " MB"; color: white; vertical-alignment: center; width: 80px; }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Java-Version"; color: white; vertical-alignment: center; width: 180px; }
                        ComboBox {
                            model: root.available_java_paths;
                            current-value <=> root.java_path;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Standard-Nutzername"; color: white; vertical-alignment: center; width: 180px; }
                        username_box := LineEdit {
                            placeholder-text: "TestUser";
                            text: root.default_username;
                        }
                    }

                    Rectangle { height: 10px; } // Trenner-Abstand

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Elemente pro Ansicht"; color: white; vertical-alignment: center; width: 180px; }
                        items_slider := Slider { minimum: 4; maximum: 48; value: root.items_per_page; }
                        Text { text: round(items_slider.value); color: white; vertical-alignment: center; width: 40px; }
                    }
                    debug_ui_box := CheckBox { text: "Debug-UI anzeigen"; checked: root.debug_ui; }

                    Rectangle { height: 10px; }

                    Text { text: "Performance"; font-size: 18px; font-weight: 700; color: white; }

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Device-Tier"; color: white; vertical-alignment: center; width: 180px; }
                        ComboBox {
                            model: ["auto", "low", "mid", "high"];
                            current-value <=> root.settings_device_tier;
                        }
                        Text {
                            text: "(aktuell: " + (root.settings_device_tier == "auto" ? "auto erkannt" : root.settings_device_tier) + ")";
                            color: #7a8291;
                            vertical-alignment: center;
                            font-size: 12px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: ""; width: 180px; }
                        Button {
                            text: "Apply & Icons neu cachen";
                            width: 220px;
                            clicked => { root.apply_device_tier(root.settings_device_tier, true); }
                        }
                        Button {
                            text: "Nur speichern";
                            width: 130px;
                            clicked => { root.apply_device_tier(root.settings_device_tier, false); }
                        }
                    }
                    Text {
                        text: "Tier beeinflusst Icon-Größe (64/96/128), Log-Puffer, Download-Parallelität.";
                        color: #7a8291;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Text { text: "Launcher"; font-size: 18px; font-weight: 700; color: white; }

                    close_after_launch_box := CheckBox { text: "Launcher beim Spielen minimieren (Tray) und danach wieder öffnen"; checked: root.close_after_launch; }
                    open_on_startup_box := CheckBox { text: "Beim Systemstart öffnen"; checked: root.open_on_startup; }
                    show_snapshots_box := CheckBox { text: "Snapshot-Versionen anzeigen"; checked: root.show_snapshots; }

                    Rectangle { vertical-stretch: 1; }

                                        Button {
                        text: "Speichern";
                        primary: true;
                        width: 120px;
                        clicked => {
                            // Werte erst lokal in die properties übernehmen, dann Callback feuern
                            root.default_ram_mb = round(ram_slider.value);
                            // root.java_path wird bereits live durch die ComboBox aktualisiert, 
                            // wir müssen es hier nicht mehr aus einem Textfeld lesen!
                            root.default_username = username_box.text;
                            root.close_after_launch = close_after_launch_box.checked;
                            root.open_on_startup = open_on_startup_box.checked;
                            root.show_snapshots = show_snapshots_box.checked;
                            root.items_per_page = round(items_slider.value);
                            root.debug_ui = debug_ui_box.checked;

                            root.save_settings(
                                root.default_ram_mb,
                                root.java_path,
                                root.default_username,
                                root.close_after_launch,
                                root.open_on_startup,
                                root.show_snapshots,
                                root.items_per_page,
                                root.debug_ui,
                            );
                        }
                    }
                }

                                if selected_panel == "Presets" : VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text { text: "Presets"; font-size: 18px; font-weight: 700; color: white; }

                    HorizontalLayout {
                        spacing: 12px;
                        vertical-stretch: 1;

                        // Linke Spalte: Liste der Presets
                        VerticalLayout {
                            width: 250px;
                            spacing: 6px;

                            Text { text: "Meine Presets"; color: white; font-weight: 700; font-size: 14px; }
                            if root.presets_status != "" : Text { text: root.presets_status; color: #a0a8b5; font-size: 11px; wrap: word-wrap; }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;
                                    for p in root.presets_list : Rectangle {
                                        height: 50px;
                                        background: root.preset_selected_id == p.id ? #2c4a66 : #1e2632;
                                        border-radius: 4px;

                                        preset_area := TouchArea { clicked => { root.preset_select(p.id); } }

                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 2px;
                                            Text { text: p.name; color: white; font-weight: 700; font-size: 13px; overflow: elide; }
                                            Text { text: p.mc_version + " · " + p.loader + " · " + p.mod_count + " Mods"; color: #7a8291; font-size: 10px; }
                                        }
                                    }
                                }
                            }
                        }

                        // Rechte Spalte: Detail / Neu erstellen
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;

                            Text { text: "Neues Preset erstellen"; color: white; font-weight: 700; font-size: 14px; }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Name:"; color: white; width: 80px; vertical-alignment: center; }
                                preset_name_box := LineEdit {
                                    placeholder-text: "z.B. Vanilla+ Performance";
                                    text <=> root.preset_new_name;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "MC-Version:"; color: white; width: 80px; vertical-alignment: center; }
                                preset_mc_box := ComboBox {
                                    model: root.mcVersions;
                                    current-value <=> root.preset_new_mc;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Loader:"; color: white; width: 80px; vertical-alignment: center; }
                                ComboBox {
                                    model: ["vanilla", "fabric", "forge", "neoforge", "quilt"];
                                    current-value <=> root.preset_new_loader;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Mods (" + root.preset_new_mods.length + "):"; color: white; width: 80px; vertical-alignment: center; }
                                Button {
                                    text: "+ Mod hinzufügen";
                                    width: 140px;
                                    clicked => {
                                        root.preset_add_mod_popup_visible = true;
                                        root.preset_new_add_mod_search("");
                                    }
                                }
                            }

                            ScrollView {
                                height: 120px;
                                VerticalLayout {
                                    spacing: 2px;
                                    for m in root.preset_new_mods : HorizontalLayout {
                                        height: 24px;
                                        spacing: 8px;
                                        Image { source: m.icon; width: 18px; height: 18px; }
                                        Text { text: m.project_name; color: white; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        Button {
                                            text: "Entfernen";
                                            width: 90px;
                                            height: 20px;
                                            clicked => { root.preset_new_remove_mod(m.project_id); }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 4px; }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Button {
                                    text: "Preset speichern";
                                    primary: true;
                                    width: 160px;
                                    clicked => { root.preset_new_save(); }
                                }
                                Button {
                                    text: "Preset löschen";
                                    width: 140px;
                                    enabled: root.preset_selected_id != "";
                                    clicked => { root.preset_delete(root.preset_selected_id); }
                                }
                            }

                            Rectangle { height: 4px; }

                            Text { text: "Preset auf Instanz anwenden"; color: white; font-weight: 700; font-size: 14px; }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                ComboBox {
                                    model: root.preset_apply_targets_names; // reuse: enthält keine Instanzen... wir bauen das anders
                                    // Wir nutzen stattdessen die Instanznamen aus packs
                                    current-value <=> root.preset_apply_instance;
                                    horizontal-stretch: 1;
                                    // Model ist falsch — siehe Rust-Callback. Wird durch preset_apply_targets befüllt.
                                }
                                Button {
                                    text: "Anwenden";
                                    width: 120px;
                                    enabled: root.preset_selected_id != "" && root.preset_apply_instance != "";
                                    clicked => { root.preset_apply(root.preset_selected_id, root.preset_apply_instance); }
                                }
                            }
                        }
                    }
                }

                                if selected_panel == "Achievements" : ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 8px;
                        alignment: start;

                        Text { text: "Achievements"; font-size: 18px; font-weight: 700; color: white; }
                        Text { text: root.achievements_summary; color: #7bdc8a; font-size: 12px; }

                        Text { text: "Neueste 5"; font-size: 14px; font-weight: 700; color: white; }
                        if root.achievements_recent.length == 0 : Text {
                            text: "Noch keine Achievements erfasst. Sie werden nach dem Beenden von Minecraft aus der latest.log gelesen.";
                            color: #7a8291;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        for a in root.achievements_recent : AchievementCard {
                            title: a.title_big;
                            description: a.description;
                            meta: a.meta;
                            kind: a.kind;
                            icon: a.icon;
                            is_new: a.is_new;
                        }

                        Rectangle { height: 10px; }
                        Text { text: "Pro Modpack / Instanz  (grün = aus der letzten Session)"; font-size: 14px; font-weight: 700; color: white; }

                                                for a in root.achievements_all : VerticalLayout {
                            spacing: 2px;

                            // Blaue Überschrift: Klick klappt die Gruppe ein/aus
                            if a.header != "" : Rectangle {
                                height: 34px;
                                header_area := TouchArea {
                                    clicked => { root.achievements_toggle(a.instance); }
                                }
                                Text {
                                    text: a.header;
                                    color: header_area.has-hover ? #7dbbff : #4da3ff;
                                    font-size: 15px;
                                    font-weight: 800;
                                    vertical-alignment: bottom;
                                }
                            }

                            // Zeile: "Welt/Server - Achievement" in grün, Zeit rechts
                            if !a.collapsed : HorizontalLayout {
                                height: 22px;
                                spacing: 10px;
                                Text {
                                    text: a.line;
                                    color: #7bdc8a;
                                    font-weight: a.is_new ? 800 : 400;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text { text: a.short; color: #7a8291; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; width: 100px; overflow: elide; }
                            }
                        }
                    }
                }

                if selected_panel == "Statistik" : ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        alignment: start;

                        Text { text: "Statistik"; font-size: 18px; font-weight: 700; color: white; }
                        Text { text: root.stats_summary; color: #7bdc8a; wrap: word-wrap; }

                        Text { text: "Spielzeit pro Instanz"; font-size: 14px; font-weight: 700; color: white; }
                        for r in root.stats_instances : HorizontalLayout {
                            height: 22px;
                            spacing: 8px;
                            Text { text: r.name; width: 220px; color: white; vertical-alignment: center; overflow: elide; }
                            Rectangle {
                                horizontal-stretch: 1;
                                Rectangle {
                                    width: parent.width * r.fraction;
                                    height: 14px;
                                    y: parent.height / 2 - 7px;
                                    background: #1bd96a;
                                    border-radius: 3px;
                                }
                            }
                            Text { text: r.text; width: 120px; color: #a0a8b5; vertical-alignment: center; font-size: 12px; }
                        }

                        Rectangle { height: 6px; }
                        Text { text: "Letzte 7 Tage"; font-size: 14px; font-weight: 700; color: white; }
                        for r in root.stats_days : HorizontalLayout {
                            height: 22px;
                            spacing: 8px;
                            Text { text: r.name; width: 220px; color: white; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                Rectangle {
                                    width: parent.width * r.fraction;
                                    height: 14px;
                                    y: parent.height / 2 - 7px;
                                    background: #4da3ff;
                                    border-radius: 3px;
                                }
                            }
                            Text { text: r.text; width: 120px; color: #a0a8b5; vertical-alignment: center; font-size: 12px; }
                        }

                        Rectangle { height: 6px; }
                        Text { text: "Startzeit bis Hauptmenü (pro Instanz und JVM-Preset)"; font-size: 14px; font-weight: 700; color: white; }
                        if root.stats_startups.length == 0 : Text {
                            text: "Noch keine Messung. Starte eine Instanz, die Zeit wird automatisch erfasst.";
                            color: #7a8291;
                            font-size: 12px;
                        }
                        for r in root.stats_startups : HorizontalLayout {
                            height: 22px;
                            spacing: 8px;
                            Text { text: r.name; width: 220px; color: white; vertical-alignment: center; overflow: elide; }
                            Rectangle {
                                horizontal-stretch: 1;
                                Rectangle {
                                    width: parent.width * r.fraction;
                                    height: 14px;
                                    y: parent.height / 2 - 7px;
                                    background: #ff9a2e;
                                    border-radius: 3px;
                                }
                            }
                            Text { text: r.text; width: 230px; color: #a0a8b5; vertical-alignment: center; font-size: 12px; }
                        }
                    }
                }

                                if selected_panel == "Server" : HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;

                    // ---------- Linke Spalte: Serverliste + "Neuer Server" ----------
                    VerticalLayout {
                        width: 270px;
                        spacing: 8px;

                        Text { text: "Server"; font-size: 18px; font-weight: 700; color: white; }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;

                                if root.srv_list.length == 0 : Text {
                                    text: "Noch keine Server. Lege unten einen an oder exportiere ein Server-Pack (Misc-Popup).";
                                    color: #7a8291;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    height: 50px;
                                }

                                for s in root.srv_list : Rectangle {
                                    height: 48px;
                                    background: root.srv_selected == s.name ? #2c4a66 : #1e2632;
                                    border-radius: 4px;

                                    TouchArea { clicked => { root.srv_select(s.name); } }

                                    HorizontalLayout {
                                        padding: 6px;
                                        spacing: 8px;
                                        // grüner Punkt = läuft
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            y: parent.height / 2 - 5px;
                                            background: s.running ? #1bd96a : #7a8291;
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text { text: s.name; color: white; font-weight: 700; font-size: 13px; overflow: elide; }
                                            Text {
                                                text: s.mc_version + " · " + s.loader + " · Port " + s.port
                                                    + (s.installed ? "" : " · nicht installiert")
                                                    + (s.port_conflict ? " · ⚠ Port doppelt" : "");
                                                color: s.port_conflict ? #ff9a2e : #7a8291;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 200px;
                            background: #232c3a;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                Text { text: "Neuer Server"; color: white; font-weight: 700; font-size: 13px; }
                                srv_new_name := LineEdit { placeholder-text: "Servername"; }
                                srv_new_mc := ComboBox { model: root.mcVersions; }
                                srv_new_loader := ComboBox { model: ["vanilla", "fabric", "forge", "neoforge"]; }
                                Button {
                                    text: "Server anlegen";
                                    clicked => {
                                        root.srv_create(srv_new_name.text, srv_new_mc.current-value, srv_new_loader.current-value);
                                        srv_new_name.text = "";
                                    }
                                }
                            }
                        }
                    }

                    // ---------- Rechte Spalte: Details ----------
                    if root.srv_selected == "" : Text {
                        text: "Wähle links einen Server aus.";
                        color: #7a8291;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.srv_selected != "" : ScrollView {
                        horizontal-stretch: 1;

                        VerticalLayout {
                            spacing: 10px;
                            alignment: start;

                            // Kopfzeile mit Steuerung
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: root.srv_selected; font-size: 20px; font-weight: 900; color: white; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Button { text: "Start"; primary: true; width: 80px; clicked => { root.srv_start(root.srv_selected); } }
                                Button { text: "Stop"; width: 80px; clicked => { root.srv_stop(root.srv_selected); } }
                                Button { text: "Kill"; width: 70px; clicked => { root.srv_kill(root.srv_selected); } }
                                Button { text: "Ordner"; width: 80px; clicked => { root.srv_open_folder(root.srv_selected); } }
                            }

                            if root.srv_status != "" : Text {
                                text: root.srv_status;
                                color: #a0d8a0;
                                font-size: 12px;
                                wrap: word-wrap;
                                height: 34px;
                                vertical-alignment: top;
                                overflow: elide;
                            }

                            // Konsole mit Befehlseingabe
                            Rectangle {
                                height: 300px;
                                background: #1a1e26;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;

                                    srv_console_scroll := ScrollView {
                                        vertical-stretch: 1;
                                        property <int> observe_tick: root.srv_console_tick;
                                        changed observe_tick => {
                                            if (root.srv_autoscroll) { self.content-y = 1000000px; }
                                        }

                                        VerticalLayout {
                                            spacing: 1px;
                                            if root.srv_console_lines.length == 0 : Text {
                                                text: "(Noch keine Ausgabe. Starte den Server.)";
                                                color: #7a8291;
                                                font-size: 11px;
                                            }
                                            for line in root.srv_console_lines : Text {
                                                text: line;
                                                color: #dddddd;
                                                font-size: 11px;
                                                wrap: no-wrap;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 8px;
                                        srv_cmd_box := LineEdit {
                                            placeholder-text: "Befehl, z.B. op Name  (ohne /)";
                                            accepted(t) => { root.srv_command(root.srv_selected, t); srv_cmd_box.text = ""; }
                                        }
                                        Button { text: "Senden"; width: 80px; clicked => { root.srv_command(root.srv_selected, srv_cmd_box.text); srv_cmd_box.text = ""; } }
                                        CheckBox { text: "Auto-Scroll"; checked <=> root.srv_autoscroll; }
                                    }
                                }
                            }

                            // Einstellungen
                            MiscCard {
                                title: "Einstellungen";
                                hint: "Änderungen gelten beim nächsten Start. Zwei Server dürfen nicht denselben Port nutzen, wenn sie gleichzeitig laufen.";
                                hint_height: 34px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    height: 26px;
                                    Text { text: "RAM"; color: white; vertical-alignment: center; width: 110px; }
                                    Slider { minimum: 1; maximum: 32; value <=> root.srv_ram_gb; horizontal-stretch: 1; }
                                    Text { text: round(root.srv_ram_gb) + " GB"; color: white; vertical-alignment: center; width: 60px; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    height: 28px;
                                    Text { text: "Port"; color: white; vertical-alignment: center; width: 110px; }
                                    LineEdit { text <=> root.srv_prop_port; width: 100px; }
                                    Text { text: "Max. Spieler"; color: white; vertical-alignment: center; width: 100px; }
                                    LineEdit { text <=> root.srv_prop_max; width: 80px; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    height: 28px;
                                    Text { text: "MOTD"; color: white; vertical-alignment: center; width: 110px; }
                                    LineEdit { text <=> root.srv_prop_motd; horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    height: 28px;
                                    Text { text: "Schwierigkeit"; color: white; vertical-alignment: center; width: 110px; }
                                    ComboBox { model: ["peaceful", "easy", "normal", "hard"]; current-value <=> root.srv_prop_difficulty; width: 160px; }
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    height: 28px;
                                    CheckBox { text: "Whitelist"; checked <=> root.srv_prop_whitelist; }
                                    CheckBox { text: "Online-Modus (Account-Prüfung)"; checked <=> root.srv_prop_online; }
                                }
                                CheckBox { text: "Ich akzeptiere die Minecraft-EULA (aka.ms/MinecraftEULA)"; checked <=> root.srv_eula; }
                                Button {
                                    text: "Speichern";
                                    primary: true;
                                    width: 140px;
                                    clicked => {
                                        root.srv_save(
                                            root.srv_selected,
                                            round(root.srv_ram_gb * 1024),
                                            root.srv_eula,
                                            root.srv_prop_port,
                                            root.srv_prop_max,
                                            root.srv_prop_motd,
                                            root.srv_prop_difficulty,
                                            root.srv_prop_whitelist,
                                            root.srv_prop_online
                                        );
                                    }
                                }
                            }

                            // Löschen mit Bestätigung (gleiches Muster wie bei Instanzen)
                            MiscCard {
                                title: "Server löschen";
                                hint: "Löscht den Server-Ordner samt Welt endgültig. Ein laufender Server kann nicht gelöscht werden.";
                                if !root.srv_confirm_delete : Button { text: "Server löschen..."; width: 170px; clicked => { root.srv_confirm_delete = true; } }
                                if root.srv_confirm_delete : HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    Text { text: "Wirklich löschen? Das geht nicht rückgängig."; color: #e08a8a; vertical-alignment: center; horizontal-stretch: 1; }
                                    Rectangle {
                                        width: 110px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: srv_del_area.has-hover ? #e04040 : #c93030;
                                        srv_del_area := TouchArea { clicked => { root.srv_delete(root.srv_selected); } }
                                        Text { text: "Ja, löschen"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Button { text: "Abbrechen"; width: 90px; clicked => { root.srv_confirm_delete = false; } }
                                }
                            }
                        }
                    }
                }

                if selected_panel == "Accounts" : VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    alignment: start;

                    Text { text: "Accounts"; font-size: 18px; font-weight: 700; color: white; }

                    HorizontalLayout {
                        max-height: 40px;
                        spacing: 10px;

                        account_username_box := LineEdit {
                            placeholder-text: "Offline-Username...";
                            accepted(text) => {
                                root.account_add_offline(text);
                                account_username_box.text = "";
                            }
                        }
                        Button {
                            text: "Offline-Account hinzufügen";
                            width: 200px;
                            clicked => {
                                root.account_add_offline(account_username_box.text);
                                account_username_box.text = "";
                            }
                        }
                    }

                    HorizontalLayout {
                        max-height: 30px;
                        Button {
                            text: "Microsoft-Account hinzufügen";
                            width: 220px;
                            clicked => { root.account_add_microsoft(); }
                        }
                    }

                    if root.accounts_status != "" : Text {
                        text: root.accounts_status;
                        color: #a0d8a0;
                        wrap: word-wrap;
                        font-size: 12px;
                    }

                    Rectangle { height: 6px; } // Trenner-Abstand

                    Text { text: "Gespeicherte Accounts"; font-size: 14px; font-weight: 700; color: white; }

                    VerticalLayout {
                        spacing: 6px;
                        for acc in root.accounts : HorizontalLayout {
                            max-height: 30px;
                            spacing: 10px;

                            Text {
                                text: acc.username + " (" + acc.kind + ")" + (acc.selected ? "  – aktiv" : "");
                                color: acc.selected ? red : white;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Auswählen";
                                width: 100px;
                                height: 24px;
                                enabled: !acc.selected;
                                clicked => { root.account_select(acc.id); }
                            }
                            Button {
                                text: "Entfernen";
                                width: 90px;
                                height: 24px;
                                clicked => { root.account_remove(acc.id); }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                if selected_panel == "Instance Detail" : ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        HorizontalLayout {
                            max-height: 30px;
                            spacing: 10px;
                            Button {
                                text: "< Zurück";
                                width: 90px;
                                clicked => { root.selected_panel = "Instanzen" }
                            }
                            Image { source: root.detail_instance_icon; width: 28px; height: 28px; }
                            Text {
                                text: root.detail_instance_name;
                                font-size: 20px;
                                font-weight: 900;
                                color: white;
                                vertical-alignment: center;
                            }
                            Text { text: "Spielzeit: " + root.instance_playtime(root.detail_instance_name, root.playtime_tick); color: #7bdc8a; font-size: 12px; vertical-alignment: center; }
                        }

                        Text { text: "Mods"; font-size: 16px; font-weight: 700; color: white; }
                        HorizontalLayout {
                            max-height: 30px;
                            spacing: 10px;
                            alignment: start; // Buttons behalten ihre feste Breite und stehen links nebeneinander

                            LineEdit {
                                placeholder-text: "Mods durchsuchen...";
                                text <=> root.mod_filter;
                                edited(t) => { root.detail_filter_mods(root.detail_instance_name, t) }
                            }

                            Button {
                                text: "+ Mod hinzufügen";
                                width: 160px;
                                clicked => {
                                    root.add_mod_popup_visible = true;
                                    root.add_mod_status = "";
                                    root.detail_add_mod_search("");
                                }
                            }
                            Button {
                                text: "Im Ordner öffnen";
                                width: 160px;
                                clicked => { root.detail_open_folder(root.detail_instance_name) }
                            }
                            Button { text: "Misc"; width: 80px; clicked => { root.misc_open(root.detail_instance_name) } }
                            Button { text: "Absturz-Analyse"; width: 150px; clicked => { root.crash_analyze(root.detail_instance_name) } }
                            //Button { text: "Manage Instanz"; width: 130px; clicked => { root.manage_open(root.detail_instance_name) } }
                                                        Button { text: "Manage Instanz"; width: 130px; clicked => { root.manage_open(root.detail_instance_name); root.manage_update_load(root.detail_instance_name); } }
                        }

                        mods_scroll := ScrollView {
                            height: 260px; // feste Höhe, die ganze Seite scrollt jetzt außen
                            VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                for mod_file in root.detail_mod_files : HorizontalLayout {
                                    max-height: 26px;
                                    spacing: 10px;
                                    Image { source: mod_file.icon; width: 20px; height: 20px; }
                                    Text {
                                        text: mod_file.display_name;
                                        color: mod_file.duplicate ? #ff9a2e : (mod_file.orphan ? #c792ea : (mod_file.enabled ? white : #7a8291)); // orange = doppelt, lila = verwaiste Library
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Button {
                                        text: mod_file.enabled ? "Deaktivieren" : "Aktivieren";
                                        width: 110px;
                                        height: 24px;
                                        clicked => { root.detail_toggle_mod(root.detail_instance_name, mod_file.filename) }
                                    }
                                    Button {
                                        text: "Entfernen";
                                        width: 90px;
                                        height: 24px;
                                        clicked => { root.detail_remove_mod(root.detail_instance_name, mod_file.filename) }
                                    }
                                }

                                // ---- Gruppe "Doppelte Mods" unter einem Trennstrich ----
                                if root.dup_total > 0 : Rectangle { height: 1px; background: #55607a; }
                                if root.dup_total > 0 : Text { text: "Doppelte Mods (" + root.dup_total + ")"; color: #ff9a2e; font-weight: 700; }
                                if root.dup_total > 0 : VerticalLayout {
                                    spacing: 0px; // damit die ausgeblendeten Zeilen (Höhe 0) keine Lücken erzeugen
                                    for m in root.detail_mod_files : Rectangle {
                                        height: m.duplicate ? 22px : 0px;
                                        clip: true;
                                        Text { text: m.display_name; color: #ff9a2e; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                if root.dup_total > 0 : HorizontalLayout {
                                    height: 28px;
                                    spacing: 10px;
                                    Button {
                                        text: "Doppelte Mods beheben...";
                                        width: 210px;
                                        enabled: root.misc_auto_fix_dupes; // standardmäßig gesperrt (Misc-Popup)
                                        clicked => { root.duplicates_fix(root.detail_instance_name) }
                                    }
                                    Text {
                                        text: root.misc_auto_fix_dupes ? root.dup_status : "Gesperrt: erst im Misc-Popup \"Automatisches Beheben erlauben\" aktivieren und speichern.";
                                        color: #a0a8b5;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        
                                                // Feature 14: Welten (links) + Server (rechts)
                        Rectangle {
                            background: #232c3a;
                            border-radius: 6px;
                            height: 260px;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 12px;

                                    // Linke Spalte: Welten
                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            height: 20px;
                                            Text { text: "Welten"; color: white; font-weight: 700; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                            Text { text: root.detail_worlds_status; color: #a0a8b5; font-size: 11px; vertical-alignment: center; }
                                        }

                                        if root.detail_worlds.length == 0 : Text {
                                            text: "Keine Welten in dieser Instanz.";
                                            color: #7a8291;
                                            font-size: 11px;
                                        }

                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                spacing: 3px;
                                                for w in root.detail_worlds : Rectangle {
                                                    height: 30px;
                                                    background: world_area.has-hover ? #2f3a4c : #1e2632;
                                                    border-radius: 4px;

                                                    world_area := TouchArea { }

                                                    HorizontalLayout {
                                                        padding: 4px;
                                                        spacing: 6px;
                                                        Image { source: w.icon; width: 22px; height: 22px; }
                                                        VerticalLayout {
                                                            spacing: 0px;
                                                            Text {
                                                                text: w.display_name + (w.hardcore ? "  ☠" : "");
                                                                color: w.hardcore ? #ff5c5c : white;
                                                                font-size: 12px;
                                                                vertical-alignment: center;
                                                                horizontal-stretch: 1;
                                                                overflow: elide;
                                                            }
                                                            Text {
                                                                text: w.game_type_text + " · " + w.version + " · " + w.last_played_text;
                                                                color: #7a8291;
                                                                font-size: 9px;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        Button {
                                                            text: "Play";
                                                            width: 60px;
                                                            height: 22px;
                                                            primary: true;
                                                            clicked => { root.world_play(root.detail_instance_name, w.folder_name) }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Rechte Spalte: Server
                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            height: 20px;
                                            Text { text: "Server"; color: white; font-weight: 700; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                            Text { text: root.detail_servers_status; color: #a0a8b5; font-size: 11px; vertical-alignment: center; }
                                            Button {
                                                text: "Aktualisieren";
                                                width: 110px;
                                                height: 20px;
                                                clicked => { root.refresh_servers(root.detail_instance_name) }
                                            }
                                        }

                                        if root.detail_servers.length == 0 : Text {
                                            text: "Keine Server in servers.dat.";
                                            color: #7a8291;
                                            font-size: 11px;
                                        }

                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                spacing: 3px;
                                                for s in root.detail_servers : Rectangle {
                                                    height: 30px;
                                                    background: server_area.has-hover ? #2f3a4c : #1e2632;
                                                    border-radius: 4px;

                                                    server_area := TouchArea { }

                                                    HorizontalLayout {
                                                        padding: 4px;
                                                        spacing: 6px;

                                                        // Status-Punkt
                                                        Rectangle {
                                                            width: 10px;
                                                            height: 10px;
                                                            border-radius: 5px;
                                                            y: parent.height/2 - 5px;
                                                            background: s.status == "online" ? #1bd96a
                                                                      : s.status == "offline" ? #e04040
                                                                      : s.status == "checking" ? #ffd43b
                                                                      : #7a8291;
                                                        }

                                                        Image { source: s.icon; width: 22px; height: 22px; }

                                                        VerticalLayout {
                                                            spacing: 0px;
                                                            Text {
                                                                text: s.name;
                                                                color: white;
                                                                font-size: 12px;
                                                                vertical-alignment: center;
                                                                horizontal-stretch: 1;
                                                                overflow: elide;
                                                            }
                                                            Text {
                                                                text: s.ip + (s.players_text != "" ? " · " + s.players_text : "");
                                                                color: #7a8291;
                                                                font-size: 9px;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        Button {
                                                            text: "Join";
                                                            width: 55px;
                                                            height: 22px;
                                                            primary: true;
                                                            clicked => { root.server_join(root.detail_instance_name, s.ip) }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 10px; }
                        Text { text: "Erweiterte Einstellungen für diese Instanz"; font-size: 16px; font-weight: 700; color: white; }

                        detail_overrides_box := CheckBox {
                            text: "Globale Einstellungen für diese Instanz überschreiben";
                            checked <=> root.detail_overrides_enabled; // Zwei-Wege: Klick ändert die Property, Rust-Setter ändert die Checkbox
                        }

                        Rectangle {
                            // Immer vorhanden (damit detail_ram_slider vom Speichern-Button erreichbar bleibt),
                            // nur ein-/ausgeblendet: bei ausgeschaltetem Override Höhe 0 und unsichtbar.
                            height: detail_overrides_box.checked ? 360px : 0px;
                            visible: detail_overrides_box.checked;
                            
                            Rectangle {
                                background: #232c3a;
                                border-radius: 6px;
                                
                                VerticalLayout {
                                    spacing: 12px;
                                    padding: 10px;

                                    // 1. RAM (Slider + MB/GB Toggle)
                                    Text { text: "Zugewiesener Arbeitsspeicher"; font-size: 14px; font-weight: 700; color: #a0a8b5; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        detail_ram_slider := Slider {
                                            minimum: 1;
                                            maximum: 32;
                                            value: root.detail_ram_mb / 1024; 
                                            horizontal-stretch: 1;
                                        }
                                        ComboBox {
                                            width: 80px;
                                            model: ["MB", "GB"];
                                            current-value <=> root.detail_ram_unit; // Automatische Zwei-Wege-Bindung
                                            //activated(index) => { root.detail_ram_unit = self.model[index]; }
                                        }
                                        Text {
                                            width: 80px;
                                            text: root.detail_ram_unit == "GB" 
                                                ? round(detail_ram_slider.value) + " GB" 
                                                : round(detail_ram_slider.value * 1024) + " MB";
                                            color: white;
                                            vertical-alignment: center;
                                            font-weight: 700;
                                        }
                                    }

                                    // 2. Java-Version Dropdown
                                    Text { text: "Java-Version"; font-size: 14px; font-weight: 700; color: #a0a8b5; }
                                    ComboBox {
                                        model: root.available_java_paths;
                                        current-value <=> root.detail_java_selection;
                                    }

                                    // 3. Account Auswahl Dropdown
                                    Text { text: "Benutzerkonto für diese Instanz"; font-size: 14px; font-weight: 700; color: #a0a8b5; }
                                    ComboBox {
                                        model: root.available_accounts;
                                        current-value <=> root.detail_account_selection;
                                    }

                                    // 4. Fenstergröße
                                    Text { text: "Fenstergröße"; font-size: 14px; font-weight: 700; color: #a0a8b5; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: "Breite:"; color: white; vertical-alignment: center; width: 60px; }
                                        SpinBox {
                                            value <=> root.detail_window_width; // Automatische Zwei-Wege-Bindung
                                            width: 80px;
                                            minimum: 640;
                                            maximum: 3840;
                                        }
                                        Text { text: "Höhe:"; color: white; vertical-alignment: center; width: 60px; }
                                        SpinBox {
                                            value <=> root.detail_window_height; // Automatische Zwei-Wege-Bindung
                                            width: 80px;
                                            minimum: 480;
                                            maximum: 2160;
                                        }
                                        CheckBox { 
                                            text: "Vollbild"; 
                                            checked <=> root.detail_fullscreen;
                                        }
                                    }
                                } // <--- Schließt VerticalLayout
                            } // <--- Schließt Rectangle (das fehlte!)
                        } // <--- Schließt ScrollView (das fehlte!)

                        Rectangle { vertical-stretch: 1; }

                        Button {
                            text: "Einstellungen speichern";
                            primary: true;
                            width: 100%;
                            clicked => {
                                let final_ram_mb = round(detail_ram_slider.value * 1024);
                                root.detail_save_overrides(
                                    root.detail_instance_name,
                                    root.detail_overrides_enabled,
                                    final_ram_mb,
                                    root.detail_java_selection,
                                    root.detail_account_selection,
                                    root.detail_window_width,
                                    root.detail_window_height,
                                    root.detail_fullscreen
                                );
                            }
                        }
                    }
                } // <--- Schließt den gesamten Instance Detail Block
            }
        }
    }
    running_bar := RunningBar {
        y: parent.height - self.height; // klebt am unteren Rand, wächst nach oben
        width: 100%;
        instances: root.running_instances;
        expanded <=> root.running_bar_expanded;
        force_stop(n) => { root.force_stop(n) }
        open_console(n) => { root.console_open(n) }
    }

    if popup_new_instance : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {popup_new_instance = false}
        }

        Rectangle {
            width: 50%;
            height: 50%;

            x: parent.width/4;
            y: parent.height/4;

            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 20px;
                padding: 10px;

                Text {
                    text: "Instance Name";
                    vertical-alignment: bottom;
                    horizontal-alignment: center;
                }
                instance_name := LineEdit {
                    placeholder-text: "Instance Name here...";
                }
                
                Text {
                    text: "Minecraft Version";
                    vertical-alignment: bottom;
                    horizontal-alignment: center;
                }
                instance_version := ComboBox {
                    model: mcVersions;
                }

                Text {
                    text: "Modloader";
                    vertical-alignment: bottom;
                    horizontal-alignment: center;
                }
                instance_modloader := ComboBox {
                    model: ["Vanilla", "Fabric", "Forge", "neoforge"];
                }

                Button {
                    text: "Create & Run";
                    clicked => {create_and_run(instance_name.text, instance_version.current-value, instance_modloader.current-value)}
                }

            }
        }
    }

    if manage_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.manage_popup_visible = false } }

        Rectangle {
            width: 60%;
            height: 60%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;
            border-radius: 6px;
            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    max-height: 30px;
                    Text { text: "Manage: " + root.detail_instance_name; color: white; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: "Schließen"; width: 90px; clicked => { root.manage_popup_visible = false } }
                }
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        padding: 4px;

                        MiscCard {
                            title: "Duplizieren";
                            hint: "Kopiert die komplette Instanz (Mods, Configs, Welten) unter neuem Namen.";
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                dup_name_box := LineEdit { placeholder-text: "Neuer Name"; horizontal-stretch: 1; }
                                Button { text: "Duplizieren"; width: 110px; clicked => { root.manage_duplicate(root.detail_instance_name, dup_name_box.text) } }
                            }
                        }

                        MiscCard {
                            title: "Umbenennen";
                            hint: "Benennt Ordner und Instanz um. Die Instanz darf dabei nicht laufen.";
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                rename_box := LineEdit { placeholder-text: "Neuer Name"; horizontal-stretch: 1; }
                                Button { text: "Umbenennen"; width: 110px; clicked => { root.manage_rename(root.detail_instance_name, rename_box.text) } }
                            }
                        }

                        MiscCard {
                            title: "Exportieren";
                            hint: "Als .zip: die komplette Instanz (ohne logs und crash-reports). Als .mrpack: zum Teilen mit Freunden, Mods als Modrinth-Links, ohne Welten.";
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Button { text: "Als .zip exportieren"; width: 190px; clicked => { root.manage_export(root.detail_instance_name) } }
                                Button { text: "Als .mrpack exportieren"; width: 200px; clicked => { root.manage_export_mrpack(root.detail_instance_name) } }
                            }
                        }

                        MiscCard {
                            title: "Loader-Version";
                            hint: "Aktuell: " + root.manage_loader_current + ". Vor jedem Wechsel werden die Mods geprüft; bei Konflikten wird nichts geändert.";
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                loader_combo := ComboBox { model: root.manage_loader_versions; horizontal-stretch: 1; }
                                Button { text: "Prüfen"; width: 90px; clicked => { root.manage_loader_check(root.detail_instance_name, loader_combo.current-value) } }
                                Button { text: "Neueste prüfen"; width: 130px; clicked => { root.manage_loader_latest(root.detail_instance_name) } }
                            }
                            if root.manage_loader_report != "" : Text { text: root.manage_loader_report; color: #dddddd; font-size: 12px; wrap: word-wrap; }
                            if root.manage_loader_pending != "" : HorizontalLayout {
                                height: 30px;
                                Button {
                                    text: "Wechsel bestätigen (" + root.manage_loader_pending + ")";
                                    primary: true;
                                    clicked => { root.manage_loader_apply(root.detail_instance_name, root.manage_loader_pending) }
                                }
                            }
                        }

                        MiscCard {
                            title: "Update Instanz using .mrpack";
                            hint: "Spielt eine lokal gespeicherte .mrpack-Datei als Update ein. Gleiche Logik wie das Modpack-Update: Welten und deine Config-Änderungen bleiben erhalten. Nach dem Prüfen erscheint unten bei 'Modpack-Update' der Bericht mit dem Button 'Update durchführen'.";
                            hint_height: 66px;
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                update_file_box := LineEdit {
                                    placeholder-text: "/pfad/zur/neuen-version.mrpack";
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "Update Instanz using .mrpack";
                                    width: 230px;
                                    clicked => { root.manage_update_from_file(root.detail_instance_name, update_file_box.text) }
                                }
                            }
                        }

                        MiscCard {
                            title: "Modpack-Update";
                            hint: root.manage_update_supported
                                ? "Neue Pack-Version einspielen. Welten und deine Config-Änderungen bleiben erhalten, nur bei echten Konflikten wirst du gefragt."
                                : "Nur für Modrinth-Modpacks, die über den Launcher installiert wurden (ältere Instanzen haben keine Herkunftsangabe).";
                            if root.manage_update_supported : HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                update_combo := ComboBox { model: root.manage_update_versions; horizontal-stretch: 1; }
                                Button { text: "Prüfen"; width: 90px; clicked => { root.manage_update_check(root.detail_instance_name, update_combo.current-index) } }
                            }
                            if root.manage_update_report != "" : Text { text: root.manage_update_report; color: #dddddd; font-size: 12px; wrap: word-wrap; }
                            if root.manage_update_pending : HorizontalLayout {
                                height: 30px;
                                Button { text: "Update durchführen"; primary: true; clicked => { root.manage_update_apply(root.detail_instance_name) } }
                            }
                        }

                        MiscCard {
                            title: "Desktop-Verknüpfung";
                            hint: "Erstellt eine Verknüpfung, die diese Instanz direkt startet — ohne den Launcher manuell zu öffnen.";
                            Button {
                                text: "Verknüpfung erstellen";
                                width: 200px;
                                clicked => { root.create_shortcut(root.detail_instance_name) }
                            }
                        }


                        MiscCard {
                            title: "Löschen";
                            hint: "Löscht die Instanz samt Welten endgültig. Eine laufende Instanz kann nicht gelöscht werden.";
                            if !root.manage_confirm_delete : Button { text: "Instanz löschen..."; width: 170px; clicked => { root.manage_confirm_delete = true } }
                            if root.manage_confirm_delete : HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Wirklich löschen? Das geht nicht rückgängig."; color: #e08a8a; vertical-alignment: center; horizontal-stretch: 1; }
                                Rectangle {
                                    width: 110px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: del_area.has-hover ? #e04040 : #c93030;
                                    del_area := TouchArea { clicked => { root.manage_delete(root.detail_instance_name) } }
                                    Text { text: "Ja, löschen"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Button { text: "Abbrechen"; width: 90px; clicked => { root.manage_confirm_delete = false } }
                            }
                        }

                        if root.manage_status != "" : Text { text: root.manage_status; color: #a0d8a0; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    // Install-Popup: Version eines Modpacks aus dem Browser auswählen.
    // Mehrfach-Installation ist möglich, da jede Bestätigung eine neue,
    // eigene Instanz anlegt (Name enthält die gewählte Version) statt eine
    // bestehende zu überschreiben. Zeigt während des Downloads Fortschritt
    // (install_popup_status) und blockt die Buttons (install_popup_installing).
    if install_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {
                if (!root.install_popup_installing) {
                    root.install_popup_visible = false;
                }
            }
        }

        Rectangle {
            width: 40%;
            height: 34%;

            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;

            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 16px;
                padding: 16px;

                Text {
                    text: "Version installieren: " + root.install_popup_pack_name;
                    color: white;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                install_version_combo := ComboBox {
                    model: root.install_popup_versions; // Labels wie "1.2.0 (1.21.1)"
                    enabled: !root.install_popup_installing;
                }

                if root.install_popup_status != "" : Text {
                    text: root.install_popup_status;
                    color: #a0d8a0; // dezent grün, dient auch für Fehlermeldungen (kein extra Rot-Handling gewünscht -> einfach gehalten)
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Button {
                        text: "Abbrechen";
                        enabled: !root.install_popup_installing;
                        clicked => { root.install_popup_visible = false }
                    }
                    Button {
                        text: root.install_popup_installing ? "Installiere..." : "Installieren";
                        primary: true;
                        enabled: !root.install_popup_installing;
                        clicked => {
                            root.install_popup_installing = true;
                            root.install_popup_status = "Installation wird gestartet...";
                            root.browser_confirm_install(install_version_combo.current-index);
                        }
                    }
                }
            }
        }
    }

    // Add-Mod-Popup: innerhalb der Instanz-Detailansicht, sucht Mods (nicht
    // Modpacks) über Modrinth und installiert per Klick direkt in mods/.
    if add_mod_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => { root.add_mod_popup_visible = false }
        }

        Rectangle {
            width: 60%;
            height: 60%;

            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;

            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 16px;
                padding: 16px;

                HorizontalLayout {
                    max-height: 40px;
                    spacing: 10px;

                    add_mod_search_box := LineEdit {
                        placeholder-text: "Mods durchsuchen...";
                        accepted(text) => { root.detail_add_mod_search(text) }
                    }
                    Button {
                        text: "Suchen";
                        width: 80px;
                        clicked => { root.detail_add_mod_search(add_mod_search_box.text) }
                    }
                    Button {
                        text: "Schließen";
                        width: 90px;
                        clicked => { root.add_mod_popup_visible = false }
                    }
                }

                if root.add_mod_status != "" : Text {
                    text: root.add_mod_status;
                    color: #a0d8a0;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    font-size: 12px;
                }

                add_mod_scroll := ScrollView {
                    vertical-stretch: 1;
                    property <int> cols: max(1, floor((self.width / 1px) / 240));

                    GridLayout {
                        spacing: 16px;

                        for pack[i] in root.add_mod_results : BrowserTile {
                            row: floor(i / add_mod_scroll.cols);
                            col: mod(i, add_mod_scroll.cols);
                            project_id: pack.project_id;
                            name: pack.name;
                            summary: pack.summary;
                            author: pack.author;
                            icon: pack.icon;
                            source: pack.source;
                            starred: pack.starred;
                            install_clicked(id, n, src) => { root.detail_add_mod_install(root.detail_instance_name, id, n) }
                            toggle_star(id) => { root.toggle_favorite("mods", id) }
                        }
                    }
                }

                //GridLayout {
                //    spacing: 16px;
                //  
                //    for pack[i] in root.add_mod_results : BrowserTile {
                //        row: floor(i / 2);
                //        col: mod(i, 2);
                //        project_id: pack.project_id;
                //        name: pack.name;
                //        summary: pack.summary;
                //        author: pack.author;
                //        icon: pack.icon;
                //        install_clicked(id, n) => { root.detail_add_mod_install(root.detail_instance_name, id, n) }
                //    }
                //}

                //Rectangle { vertical-stretch: 1; }
            }
        }
    }

        // Preset-Mod-Popup: Mod-Browser für den Presets-Tab. Nutzt dieselben Kacheln
    // wie das Add-Mod-Popup, aber "Hinzufügen" trägt den Mod nur in die Preset-Liste ein
    // (preset_new_add_mod), es wird nichts heruntergeladen.
    if preset_add_mod_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea { clicked => { root.preset_add_mod_popup_visible = false } }

        Rectangle {
            width: 60%;
            height: 60%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;
            border-radius: 6px;

            TouchArea {} // fängt Klicks ab, damit das Popup nicht schließt

            VerticalLayout {
                spacing: 16px;
                padding: 16px;

                HorizontalLayout {
                    max-height: 40px;
                    spacing: 10px;

                    // Zeigt, nach was gerade gefiltert wird (kommt aus dem Preset-Editor)
                    Text {
                        text: "Filter: "
                            + (root.preset_new_mc == "" ? "alle Versionen" : root.preset_new_mc)
                            + "  ·  "
                            + ((root.preset_new_loader == "vanilla" || root.preset_new_loader == "") ? "kein Loader-Filter" : root.preset_new_loader);
                        color: #7bdc8a;
                        font-size: 12px;
                        height: 16px;
                    }

                    preset_mod_search_box := LineEdit {
                        placeholder-text: "Mods durchsuchen...";
                        accepted(text) => { root.preset_new_add_mod_search(text) }
                    }
                    Button {
                        text: "Suchen";
                        width: 80px;
                        clicked => { root.preset_new_add_mod_search(preset_mod_search_box.text) }
                    }
                    Button {
                        text: "Schließen";
                        width: 90px;
                        clicked => { root.preset_add_mod_popup_visible = false }
                    }
                }

                preset_mod_scroll := ScrollView {
                    vertical-stretch: 1;
                    property <int> cols: max(1, floor((self.width / 1px) / 240));

                    GridLayout {
                        spacing: 16px;

                        for pack[i] in root.preset_add_mod_results : BrowserTile {
                            row: floor(i / preset_mod_scroll.cols);
                            col: mod(i, preset_mod_scroll.cols);
                            project_id: pack.project_id;
                            name: pack.name;
                            summary: pack.summary;
                            author: pack.author;
                            icon: pack.icon;
                            source: pack.source;
                            starred: pack.starred;
                            action_text: "Hinzufügen";
                            // id = project_id, n = Name -> landet in der Preset-Mod-Liste
                            install_clicked(id, n, src) => { root.preset_new_add_mod(id, n) }
                            toggle_star(id) => { root.toggle_favorite("mods", id) }
                        }
                    }
                }
            }
        }
    }

    // Misc-Popup: Karten in einer scrollbaren Spalte.
    // Größe: 90% x 88% (vorher 80% x 50%), feste Höhen für alle umbrochenen Texte.
    if misc_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea { clicked => { root.misc_popup_visible = false } }

        Rectangle {
            width: 90%;
            height: 88%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;
            border-radius: 6px;

            TouchArea {}

            VerticalLayout {
                spacing: 12px;
                padding: 16px;

                HorizontalLayout {
                    max-height: 30px;
                    spacing: 10px;

                    Text {
                        text: "Misc: " + root.detail_instance_name;
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Schließen";
                        width: 90px;
                        clicked => { root.misc_popup_visible = false }
                    }
                }

                misc_scroll := ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        padding: 4px;

                        // 1. Freie JVM-Argumente
                        MiscCard {
                            title: "Zusätzliche JVM-Argumente";
                            hint: "Werden beim Start an Java übergeben, mit Leerzeichen trennen, z.B. -Xss2M -Dfoo=bar.";
                            LineEdit { text <=> root.misc_jvm_args; placeholder-text: "-Xss2M ..."; }
                        }

                        // 2. JVM-Presets: der Vorschlagstext kann lang werden -> 72px
                        MiscCard {
                            title: "JVM-Preset";
                            hint: root.misc_suggestion;
                            hint_height: 72px;

                            for p in root.misc_presets : Rectangle {
                                height: 150px; // FEST: verhindert das Überlappen mit der nächsten Karte
                                background: root.misc_preset_id == p.id ? #2c4a66 : #1b2330;
                                border-radius: 4px;
                                clip: true;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        height: 26px;
                                        spacing: 8px;
                                        Text {
                                            text: p.title + (p.suggested ? "  (Vorschlag)" : "");
                                            color: p.suggested ? #7bdc8a : white;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Button {
                                            text: root.misc_preset_id == p.id ? "Gewählt" : "Wählen";
                                            width: 90px;
                                            height: 24px;
                                            enabled: root.misc_preset_id != p.id;
                                            clicked => { root.misc_preset_id = p.id }
                                        }
                                    }
                                    // Beschreibung: bis zu 4 Zeilen, Rest wird mit "..." abgeschnitten
                                    Text {
                                        text: p.description;
                                        wrap: word-wrap;
                                        color: #a0a8b5;
                                        font-size: 12px;
                                        height: 68px;
                                        vertical-alignment: top;
                                        overflow: elide;
                                    }
                                    // Flags: nur eine Zeile (gekürzt)
                                    Text {
                                        text: p.flags;
                                        color: #7a8291;
                                        font-size: 10px;
                                        height: 14px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // 3. Umgebungsvariablen
                        MiscCard {
                            title: "Umgebungsvariablen";
                            hint: "Name/Wert-Paare, die dem Spielprozess mitgegeben werden (z.B. __GL_THREADED_OPTIMIZATIONS = 0).";
                            for v[i] in root.misc_env_vars : HorizontalLayout {
                                height: 26px;
                                spacing: 8px;
                                Text { text: v.name + " = " + v.value; color: white; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Button { text: "Entfernen"; width: 90px; height: 24px; clicked => { root.misc_env_remove(root.detail_instance_name, i) } }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                env_name_box := LineEdit { placeholder-text: "NAME"; width: 170px; }
                                env_value_box := LineEdit { placeholder-text: "Wert"; horizontal-stretch: 1; }
                                Button {
                                    text: "Hinzufügen";
                                    width: 100px;
                                    clicked => {
                                        root.misc_env_add(root.detail_instance_name, env_name_box.text, env_value_box.text);
                                        env_name_box.text = "";
                                        env_value_box.text = "";
                                    }
                                }
                            }
                        }

                        // 4. Wrapper-Programme
                        MiscCard {
                            title: "Wrapper-Programme";
                            hint: "Nur Programme, die auf diesem System gefunden wurden, sind wählbar.";
                            if root.misc_wrappers.length == 0 : Text { text: "Für dieses System gibt es keine passenden Wrapper."; color: #7a8291; font-size: 12px; height: 18px; }
                            for w in root.misc_wrappers : VerticalLayout {
                                spacing: 2px;
                                CheckBox {
                                    text: w.label + (w.available ? "" : "  (nicht gefunden)");
                                    checked: w.enabled;
                                    enabled: w.available;
                                    toggled => { root.misc_wrapper_toggle(root.detail_instance_name, w.id, self.checked) }
                                }
                                Text { text: w.hint; color: #7a8291; font-size: 11px; wrap: word-wrap; height: 32px; vertical-alignment: top; overflow: elide; }
                            }
                            if root.misc_wrapper_warning != "" : Text { text: root.misc_wrapper_warning; color: #ff9a2e; font-size: 12px; wrap: word-wrap; height: 36px; vertical-alignment: top; overflow: elide; }
                        }

                        // 5. System-GLFW (nur Linux)
                        if root.misc_is_linux : MiscCard {
                            title: "System-GLFW verwenden";
                            hint_height: 52px;
                            hint: root.misc_glfw_found
                                ? "Nutzt die auf deinem System installierte GLFW statt der mitgelieferten. Hilft, wenn das Fenster beim Start abstürzt (Standard: an)."
                                : "Keine System-GLFW gefunden (z.B. sudo pacman -S glfw oder sudo apt install libglfw3). Der Schalter hat dann keine Wirkung.";
                            CheckBox { text: "System-GLFW verwenden"; checked <=> root.misc_use_system_glfw; enabled: root.misc_glfw_found; }
                        }

                        // 6. Doppelte Mods
                        MiscCard {
                            title: "Doppelte Mods";
                            hint_height: 52px;
                            hint: "Doppelte Mods erscheinen in der Mod-Liste orange. Das automatische Beheben ist standardmäßig verboten; auch wenn du es erlaubst, wird nichts ohne deine Bestätigung geändert.";
                            CheckBox { text: "Automatisches Beheben erlauben"; checked <=> root.misc_auto_fix_dupes; }
                        }

                        // 7. Werkzeuge
                        MiscCard {
                            title: "Werkzeuge";
                            hint_height: 72px;
                            hint: "Server-Pack: Zip ohne Client-only-Mods in den Downloads-Ordner. Verwaiste Libraries: Mods, die von keinem anderen Mod gebraucht werden, erscheinen lila in der Mod-Liste (nur ein Hinweis, vor dem Löschen prüfen).";
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Button { text: "Server-Pack erstellen"; width: 190px; clicked => { root.sp_name = root.detail_instance_name + " Server"; root.sp_popup_visible = true; } }
                                Button { text: "Verwaiste Libraries suchen"; width: 220px; clicked => { root.orphans_scan(root.detail_instance_name) } }
                            }
                            if root.misc_tools_status != "" : Text { text: root.misc_tools_status; color: #a0d8a0; wrap: word-wrap; font-size: 12px; height: 52px; vertical-alignment: top; overflow: elide; }
                        }

                        HorizontalLayout {
                            height: 30px;
                            spacing: 10px;
                            Button {
                                text: "Speichern";
                                primary: true;
                                width: 120px;
                                clicked => {
                                    root.misc_save(root.detail_instance_name, root.misc_jvm_args, root.misc_preset_id, root.misc_use_system_glfw, root.misc_auto_fix_dupes)
                                }
                            }
                            Text { text: root.misc_status; color: #a0d8a0; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    } 

    if compat_popup_visible : Rectangle {
        width: 100%; height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.compat_cancel() } }

        Rectangle {
            width: 50%; height: 50%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;
            TouchArea {}

            VerticalLayout {
                spacing: 12px;
                padding: 16px;

                if !root.compat_conflict_visible : Text {
                    text: root.compat_mode == "update" ? "Konflikte: diese Dateien wurden von dir UND vom Modpack geändert" : "Vorgeschlagene Änderungen";
                    color: white; font-weight: 700; horizontal-alignment: center; wrap: word-wrap;
                }
                if !root.compat_conflict_visible : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;

                        for action in root.compat_actions : HorizontalLayout {
                            max-height: 26px; spacing: 10px;
                            Text { text: action.label; color: action.confirmed ? white : #7a8291; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                            Button {
                                text: root.compat_mode == "update"
                                    ? (action.confirmed ? "Neue Datei" : "Meine Datei")
                                    : (action.confirmed ? "Bestätigt" : "Übersprungen");
                                width: 110px; height: 22px;
                                clicked => { root.compat_toggle_action(action.project_id) }
                            }
                        }
                    }
                }
                if !root.compat_conflict_visible : HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Abbrechen"; clicked => { root.compat_cancel() } }
                    Button {
                        text: "Übernehmen";
                        primary: true;
                        clicked => {
                            if root.compat_mode == "duplicates" { root.duplicates_apply(root.detail_instance_name) }
                            else if root.compat_mode == "update" { root.update_confirm(root.detail_instance_name) }
                            else { root.compat_apply(root.detail_instance_name) }
                        }
                    }
                }

                if root.compat_conflict_visible : Text {
                    text: "Keine vollständig kompatible Kombination gefunden:";
                    color: white; font-weight: 700; horizontal-alignment: center; wrap: word-wrap;
                }
                if root.compat_conflict_visible : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for line in root.compat_conflicts : Text { text: line; color: #e08a8a; wrap: word-wrap; font-size: 12px; }
                    }
                }
                if root.compat_conflict_visible : HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Abbrechen"; clicked => { root.compat_cancel() } }
                    Button { text: "Betroffene Mods deaktivieren"; primary: true; clicked => { root.compat_disable_conflicts(root.detail_instance_name) } }
                }
            }
        }
    }

    // Import-Popup: lokale .mrpack-Datei (Modrinth-Modpack) als neue Instanz importieren
    if import_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => { if (!root.import_busy) { root.import_popup_visible = false; } }
        }

        Rectangle {
            width: 60%;
            height: 40%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 12px;
                padding: 16px;

                Text { text: "Modpack importieren"; color: white; font-weight: 700; horizontal-alignment: center; }
                Text {
                    text: "Pfad zur .mrpack-Datei einfügen, z.B. ~/Downloads/MeinPack.mrpack. Tipp: Im Dateimanager Rechtsklick -> Pfad kopieren.";
                    color: #a0a8b5;
                    wrap: word-wrap;
                    font-size: 12px;
                }

                import_path_box := LineEdit {
                    placeholder-text: "/pfad/zur/datei.mrpack";
                    enabled: !root.import_busy;
                }

                // Fortschritt und Fehler laufen über dieselbe Property wie beim Modpack-Install
                if root.install_popup_status != "" : Text {
                    text: root.install_popup_status;
                    color: #a0d8a0;
                    wrap: word-wrap;
                    font-size: 12px;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Abbrechen"; enabled: !root.import_busy; clicked => { root.import_popup_visible = false; } }
                    Button {
                        text: root.import_busy ? "Importiere..." : "Importieren";
                        primary: true;
                        enabled: !root.import_busy;
                        clicked => {
                            root.import_busy = true;
                            root.install_popup_status = "Starte Import...";
                            root.import_mrpack(import_path_box.text);
                        }
                    }
                }
            }
        }
    }

    // Microsoft-Login-Popup: Link öffnen, angemeldet Adresse der leeren Seite einfügen
    if ms_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => { if (!root.ms_busy) { root.ms_popup_visible = false; } }
        }

        Rectangle {
            width: 60%;
            height: 55%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 12px;
                padding: 16px;

                Text { text: "Microsoft-Login"; color: white; font-weight: 700; horizontal-alignment: center; }
                Text {
                    text: "1. Login-Seite im Browser öffnen und anmelden.\n2. Danach erscheint eine leere Seite. Kopiere die komplette Adresse aus der Adresszeile (enthält code=...).\n3. Adresse unten einfügen und auf Anmelden klicken.";
                    color: #a0a8b5;
                    wrap: word-wrap;
                    font-size: 12px;
                }

                // Link zum manuellen Kopieren, falls sich der Browser nicht automatisch öffnet
                LineEdit { text: root.ms_login_url; read-only: true; }
                HorizontalLayout {
                    Button { text: "Im Browser öffnen"; clicked => { root.account_microsoft_open_browser(); } }
                }

                ms_code_box := LineEdit {
                    placeholder-text: "Adresse oder Code hier einfügen...";
                    enabled: !root.ms_busy;
                }

                if root.ms_status != "" : Text {
                    text: root.ms_status;
                    color: #a0d8a0;
                    wrap: word-wrap;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Abbrechen"; enabled: !root.ms_busy; clicked => { root.ms_popup_visible = false; } }
                    Button {
                        text: root.ms_busy ? "Melde an..." : "Anmelden";
                        primary: true;
                        enabled: !root.ms_busy;
                        clicked => { root.account_microsoft_submit(ms_code_box.text); }
                    }
                }
            }
        }
    }

    if import_cf_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => { if (!root.import_cf_busy) { root.import_cf_popup_visible = false; } }
        }

        Rectangle {
            width: 60%;
            height: 40%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;
            TouchArea {}

            VerticalLayout {
                spacing: 12px;
                padding: 16px;

                Text { text: "CurseForge Modpack importieren"; color: white; font-weight: 700; horizontal-alignment: center; }
                Text {
                    text: "Pfad zur heruntergeladenen CurseForge .zip-Datei einfügen. Das Modpack wird automatisch konvertiert und importiert.";
                    color: #a0a8b5;
                    wrap: word-wrap;
                    font-size: 12px;
                }

                import_cf_path_box := LineEdit {
                    placeholder-text: "/pfad/zum/curseforge_pack.zip";
                    enabled: !root.import_cf_busy;
                }

                if root.install_popup_status != "" : Text {
                    text: root.install_popup_status;
                    color: #a0d8a0;
                    wrap: word-wrap;
                    font-size: 12px;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Abbrechen"; enabled: !root.import_cf_busy; clicked => { root.import_cf_popup_visible = false; } }
                    Button {
                        text: root.import_cf_busy ? "Konvertiere & Importiere..." : "Importieren";
                        primary: true;
                        enabled: !root.import_cf_busy;
                        clicked => {
                            root.import_cf_busy = true;
                            root.install_popup_status = "Starte Konvertierung und Import...";
                            root.import_cf_zip(import_cf_path_box.text);
                        }
                    }
                }
            }
        }

        // Debug-Panel: zeigt Log-Zeilen wenn debug_ui aktiv ist, liegt über allem anderen
        if root.debug_ui : Rectangle {
            y: parent.height - 150px;
            width: 100%;
            height: 150px;
            background: #000000cc;

            VerticalLayout {
                padding: 8px;
                Text { text: "Debug Log"; color: #a0d8a0; font-weight: 700; font-size: 12px; }
                ScrollView {
                    VerticalLayout {
                        for line in root.debug_log : Text { text: line; color: #dddddd; font-size: 10px; }
                    }
                }
            }
        }
    }

    // Live-Konsole: zeigt den Tail des laufenden Logs einer Instanz.
    // Ringpuffer (500 Zeilen) hält den RAM konstant; Auto-Scroll schaltet sich
    // automatisch aus, sobald der Nutzer hochscrollt, und wieder an, wenn er
    // ans Ende zurückkehrt.
    if console_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea { clicked => { root.console_close(); } }

        Rectangle {
            width: 80%;
            height: 70%;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #1a1e26;
            border-radius: 6px;

            TouchArea {}

            VerticalLayout {
                spacing: 8px;
                padding: 12px;

                HorizontalLayout {
                    max-height: 32px;
                    spacing: 8px;

                    Text {
                        text: "Live Console: " + root.console_instance_name;
                        color: #7bdc8a;
                        font-weight: 700;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.console_auto_scroll ? "Auto-Scroll: AN" : "Auto-Scroll: AUS";
                        color: root.console_auto_scroll ? #7bdc8a : #ff9a2e;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Button {
                        text: root.console_auto_scroll ? "Auto-Scroll aus" : "Auto-Scroll an";
                        width: 140px;
                        clicked => { root.console_auto_scroll = !root.console_auto_scroll; }
                    }
                    Button {
                        text: "Schließen";
                        width: 90px;
                        clicked => { root.console_close(); }
                    }
                }

                console_scroll := ScrollView {
                    vertical-stretch: 1;

                    // Lokale Bindings: erfassen Änderungen der externen Properties.
                    // `changed` funktioniert in Slint nur auf eigenen Properties der
                    // Komponente, deshalb dieser Umweg.
                    property <int> observe_tick: root.console_scroll_tick;
                    property <length> observe_viewport: self.content-y;

                    // Bei jedem neuen Log-Batch ans Ende springen.
                    changed observe_tick => {
                        if (root.console_auto_scroll) {
                            self.content-y = 1000000px;
                        }
                    }

                    // Nutzer scrollt: unten -> Auto an, sonst aus.
                    changed observe_viewport => {
                        let at_bottom = self.content-y >= self.content-height - self.height - 10px;
                        if (!at_bottom) {
                            root.console_auto_scroll = false;
                        } else {
                            root.console_auto_scroll = true;
                        }
                    }

                    VerticalLayout {
                        padding: 6px;
                        spacing: 1px;

                        if root.console_lines.length == 0 : Text {
                            text: "(Noch keine Log-Ausgabe. Die Konsole liest ab jetzt neue Zeilen mit.)";
                            color: #7a8291;
                            font-size: 11px;
                        }

                        for line in root.console_lines : Text {
                            text: line;
                            color: #dddddd;
                            font-size: 11px;
                            wrap: no-wrap;
                        }
                    }
                }
            }
        }
    }

    // Recache-Popup: Fortschrittsanzeige beim Neu-Erstellen des Icon-Caches.
    if recache_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea { } // kein Schließen durch Klick daneben — läuft bis fertig

        Rectangle {
            width: 500px;
            height: 160px;
            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;
            background: #2c3747;
            border-radius: 6px;

            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Icon-Cache wird neu erstellt";
                    color: white;
                    font-weight: 700;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.recache_status;
                    color: #a0d8a0;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    font-size: 12px;
                    height: 40px;
                }
                Rectangle {
                    height: 20px;
                    background: #1b2330;
                    border-radius: 4px;
                    Rectangle {
                        width: parent.width * root.recache_progress;
                        height: 100%;
                        background: #1bd96a;
                        border-radius: 4px;
                        animate width { duration: 200ms; easing: ease-in-out; }
                    }
                }
            }
        }
    }

        // Server-Pack-Popup: fragt vor dem Export, ob der Server auch in die Server-Liste soll
    if sp_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.sp_popup_visible = false; } }

        Rectangle {
            width: 520px;
            height: 270px;
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            background: #2c3747;
            border-radius: 6px;
            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: "Server-Pack erstellen"; color: white; font-weight: 700; font-size: 16px; horizontal-alignment: center; }
                Text {
                    text: "Das Pack (ohne Client-only-Mods) wird als .zip in den Downloads-Ordner gelegt.";
                    color: #a0a8b5;
                    font-size: 12px;
                    wrap: word-wrap;
                    height: 34px;
                }
                CheckBox { text: "Zusätzlich als Server zur Server-Liste hinzufügen"; checked <=> root.sp_add; }
                if root.sp_add : LineEdit { placeholder-text: "Name des Servers"; text <=> root.sp_name; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Abbrechen"; clicked => { root.sp_popup_visible = false; } }
                    Button {
                        text: "Erstellen";
                        primary: true;
                        clicked => {
                            root.sp_popup_visible = false;
                            root.server_pack_export(root.detail_instance_name, root.sp_add, root.sp_name);
                        }
                    }
                }
            }
        }
    }

    // Absturz-Analyse-Popup. Die Karten haben FESTE Höhen (Slint rechnet umbrochenen Text
    // in Layouts nicht breitenabhängig), sehr lange Texte werden mit "..." gekürzt.
    if crash_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        TouchArea { clicked => { root.crash_popup_visible = false; } }

        Rectangle {
            width: 70%;
            height: 80%;
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            background: #2c3747;
            border-radius: 6px;
            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    max-height: 30px;
                    spacing: 10px;
                    Text { text: "Absturz-Analyse: " + root.crash_instance; color: white; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Button { text: "Schließen"; width: 90px; clicked => { root.crash_popup_visible = false; } }
                }

                Text { text: root.crash_summary; color: #ff9a2e; font-size: 12px; wrap: word-wrap; height: 34px; vertical-alignment: top; overflow: elide; }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        alignment: start;

                        for f in root.crash_findings : Rectangle {
                            height: 230px;
                            background: #232c3a;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                Text { text: f.title; color: #ff9a2e; font-weight: 700; font-size: 14px; height: 20px; overflow: elide; }
                                Text { text: f.explanation; color: white; font-size: 12px; wrap: word-wrap; height: 70px; vertical-alignment: top; overflow: elide; }
                                Text { text: "Lösung: " + f.suggestion; color: #7bdc8a; font-size: 12px; wrap: word-wrap; height: 70px; vertical-alignment: top; overflow: elide; }
                                if f.mod_file != "" : HorizontalLayout {
                                    height: 28px;
                                    spacing: 8px;
                                    Text { text: "Verdächtig: " + f.mod_file; color: #c792ea; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Button { text: "Deaktivieren"; width: 110px; clicked => { root.crash_disable_mod(root.crash_instance, f.mod_file); } }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 30px;
                    spacing: 10px;
                    Text { text: root.crash_status; color: #a0d8a0; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Button { text: "Report / Log öffnen"; width: 170px; clicked => { root.crash_open_report(root.crash_instance); } }
                }
            }
        }
    }

    if root.launch_popup_visible : LaunchOverlay {
        width: 100%;
        height: 100%;
        instance: root.launch_instance;
        status: root.launch_status;
        progress: root.launch_progress;
    }
}