import { Button, GridBox, LineEdit, ComboBox, CheckBox, Slider, ScrollView, SpinBox } from "std-widgets.slint";

component ModpackTile inherits Rectangle {
    in property <string> name;
    in property <string> playtime; // Spielzeit-Text von Rust
    in property <image> icon;
    in property <bool> starred: false;
    in property <string> action_text: "Install"; // NEU: Button-Beschriftung, im Preset-Popup "Hinzufügen"

    width: 120px;
    height: 170px;

    callback modpack_play(string);
    callback modpack_details(string);
    callback toggle_star(string); // Feature 6

    TouchArea {
        clicked => { root.modpack_details(root.name) }
    }

    // Feature 6: Stern oben rechts als kleines overlay
    Rectangle {
        x: parent.width - 26px;
        y: 4px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: star_area.has-hover ? #3a4556 : #2c3747;

        star_area := TouchArea {
            clicked => { root.toggle_star(root.name); }
        }

        Text {
            text: root.starred ? "★" : "☆";
            color: root.starred ? #ffd43b : #7a8291;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        spacing: 6px;
        padding: 10px;
        alignment: center; //  Zentriert alle Elemente horizontal

        Text { text: root.playtime; color: #7bdc8a; font-size: 10px; horizontal-alignment: center; height: 14px; overflow: elide; }

        // NEU: HorizontalLayout als Wrapper garantiert perfekte Zentrierung des Icons
        HorizontalLayout {
            alignment: center;
            Image { source: root.icon; width: 48px; height: 48px; }
        }
        
        Text { 
            text: name; 
            horizontal-alignment: center; 
            color: white; 
            wrap: word-wrap;
            overflow: elide; // Schneidet mit "..." ab, wenn der Name zu lang ist
            height: 32px;    // Reserviert Platz für maximal 2 Zeilen
        }
        
        Button { 
            text: "Play"; 
            width: 100%;     // Füllt die Breite aus
            height: 36px; 
            primary: true; 
            clicked => { modpack_play(name) } 
        }
    }
}

struct BrowserPackInfo { project_id: string, name: string, summary: string, author: string, icon: image, source: string, starred: bool }
struct CompatibilityActionUi { project_id: string, label: string, confirmed: bool }

component BrowserTile inherits Rectangle {
    in property <string> project_id;
    in property <string> name;
    in property <string> summary;
    in property <string> author;
    in property <image> icon;
    in property <string> source;
    in property <bool> starred: false;
    in property <string> action_text: "Install";

    callback install_clicked(string, string, string);
    callback add_to_preset(string, string); // project_id, project_name — für den Preset-Tab
    callback toggle_star(string); // Feature 6

    width: 260px;
    height: 120px;
    background: #2c3747;
    border-radius: 6px;

    // Feature 6: Stern links vom Source-Badge
    Rectangle {
        x: parent.width - 100px;
        y: 4px;
        width: 22px;
        height: 16px;
        border-radius: 4px;
        background: star_area.has-hover ? #3a4556 : #232c3a;

        star_area := TouchArea {
            clicked => { root.toggle_star(root.project_id); }
        }

        Text {
            text: root.starred ? "★" : "☆";
            color: root.starred ? #ffd43b : #7a8291;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: parent.width - 72px;
        y: 4px;
        width: 68px;
        height: 16px;
        background: root.source == "CurseForge" ? #f16436 : #1bd96a;
        border-radius: 4px;
        Text {
            text: root.source;
            font-size: 9px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        spacing: 4px;
        padding: 12px;
        height: 100%; 

        // 1. Name und Icon (oben)
        HorizontalLayout {
            spacing: 8px;
            Image { source: root.icon; width: 28px; height: 28px; }
            Text { 
                text: name; 
                font-size: 14px; 
                font-weight: 700; 
                color: white; 
                vertical-alignment: center;
                overflow: elide; 
                horizontal-stretch: 1; 
            }
        }
        
        // 2. Description (Mitte) - FESTE HÖHE, um Overlap zu verhindern
        Text { 
            text: summary; 
            font-size: 11px; 
            color: #a0a8b5; 
            wrap: word-wrap;
            overflow: elide; 
            height: 36px; // <-- NEU: Begrenzt auf ca. 2-3 Zeilen, verhindert Overlap garantiert
        }
        
        // 3. Author und Install Button (unten, fest verankert)
        HorizontalLayout {
            spacing: 4px;
            Text { 
                text: "by " + author; 
                font-size: 10px; 
                color: #7a8291; 
                overflow: elide; 
                horizontal-stretch: 1; 
            }
            Button { 
                text: root.action_text; // GEÄNDERT: war fest "Install"
                height: 22px; 
                clicked => { root.install_clicked(root.project_id, root.name, root.source) } 
            }
        }
    }
}

