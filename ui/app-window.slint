import { Button, GridBox, LineEdit, ComboBox, CheckBox, Slider, ScrollView, SpinBox, StandardListView, StandardTableView } from "std-widgets.slint";

// ===== Custom Button Komponente =====
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> button-width: 120px;
    in property <length> button-height: 32px;
    callback clicked;
    width: button-width;
    height: button-height;
    border-radius: 6px;
    background: enabled ? (btn_area.pressed ? #059669 : (btn_area.has-hover ? #0d9668 : #10b981)) : #374151;
    btn_area := TouchArea {
        clicked => { if root.enabled { root.clicked(); } }
    }
    Text {
        text: root.text;
        color: root.enabled ? #ffffff : #6b7280;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> button-width: 120px;
    in property <length> button-height: 32px;
    callback clicked;
    width: button-width;
    height: button-height;
    border-radius: 6px;
    background: enabled ? (btn_area.pressed ? #1e293b : (btn_area.has-hover ? #334155 : #1e293b)) : #111827;
    border-width: 1px;
    border-color: enabled ? #334155 : #1f2937;
    btn_area := TouchArea {
        clicked => { if root.enabled { root.clicked(); } }
    }
    Text {
        text: root.text;
        color: root.enabled ? #e2e8f0 : #4b5563;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component DangerButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> button-width: 120px;
    in property <length> button-height: 32px;
    callback clicked;
    width: button-width;
    height: button-height;
    border-radius: 6px;
    background: enabled ? (btn_area.pressed ? #b91c1c : (btn_area.has-hover ? #dc2626 : #ef4444)) : #374151;
    btn_area := TouchArea {
        clicked => { if root.enabled { root.clicked(); } }
    }
    Text {
        text: root.text;
        color: root.enabled ? #ffffff : #6b7280;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ===== Sidebar Navigation Button =====
component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 44px;
    border-radius: 8px;
    background: active ? #1e293b : (nav_area.has-hover ? #1a202c : #00000000);
    nav_area := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        Rectangle {
            width: 3px;
            height: 20px;
            border-radius: 2px;
            background: root.active ? #10b981 : #00000000;
        }
        Text {
            text: root.text;
            color: root.active ? #f7fafc : #94a3b8;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// ===== Modpack Kachel =====
component ModpackTile inherits Rectangle {
    in property <string> name;
    in property <string> playtime;
    in property <image> icon;
    in property <bool> starred: false;
    in property <string> action_text: "Install";
    callback modpack_play(string);
    callback modpack_details(string);
    callback toggle_star(string);
    width: 160px;
    height: 200px;
    background: tile_area.has-hover ? #232b3a : #1a202c;
    border-radius: 10px;
    border-width: 1px;
    border-color: #1e293b;
    tile_area := TouchArea {
        clicked => { root.modpack_details(root.name) }
    }
    Rectangle {
        x: parent.width - 32px;
        y: 8px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: star_area.has-hover ? #334155 : #0f1419;
        star_area := TouchArea {
            clicked => { root.toggle_star(root.name); }
        }
        Text {
            text: root.starred ? "★" : "☆";
            color: root.starred ? #fbbf24 : #64748b;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        spacing: 8px;
        padding: 14px;
        alignment: center;
        Text {
            text: root.playtime;
            color: #10b981;
            font-size: 10px;
            horizontal-alignment: center;
            height: 14px;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 12px;
                background: #0f1419;
                clip: true;
                Image { source: root.icon; width: 64px; height: 64px; }
            }
        }
        Text {
            text: name;
            horizontal-alignment: center;
            color: #f7fafc;
            font-size: 13px;
            font-weight: 600;
            wrap: word-wrap;
            overflow: elide;
            height: 36px;
        }
        PrimaryButton {
            text: "Play";
            width: 100%;
            button-height: 32px;
            clicked => { modpack_play(name) }
        }
    }
}

// ===== Browser Kachel =====
struct BrowserPackInfo { project_id: string, name: string, summary: string, author: string, icon: image, source: string, starred: bool }
struct CompatibilityActionUi { project_id: string, label: string, confirmed: bool }

component BrowserTile inherits Rectangle {
    in property <string> project_id;
    in property <string> name;
    in property <string> summary;
    in property <string> author;
    in property <image> icon;
    in property <string> source;
    in property <bool> starred: false;
    in property <string> action_text: "Install";
    callback install_clicked(string, string, string);
    callback add_to_preset(string, string);
    callback toggle_star(string);
    width: 280px;
    height: 130px;
    background: tile_area.has-hover ? #232b3a : #1a202c;
    border-radius: 10px;
    border-width: 1px;
    border-color: #1e293b;
    tile_area := TouchArea {}
    Rectangle {
        x: parent.width - 110px;
        y: 8px;
        width: 24px;
        height: 20px;
        border-radius: 4px;
        background: star_area.has-hover ? #334155 : #0f1419;
        star_area := TouchArea {
            clicked => { root.toggle_star(root.project_id); }
        }
        Text {
            text: root.starred ? "★" : "☆";
            color: root.starred ? #fbbf24 : #64748b;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: parent.width - 80px;
        y: 8px;
        width: 72px;
        height: 20px;
        background: root.source == "CurseForge" ? #ea580c : #10b981;
        border-radius: 4px;
        Text {
            text: root.source;
            font-size: 10px;
            font-weight: 700;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        spacing: 6px;
        padding: 12px;
        height: 100%;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                background: #0f1419;
                clip: true;
                Image { source: root.icon; width: 36px; height: 36px; }
            }
            Text {
                text: name;
                font-size: 14px;
                font-weight: 700;
                color: #f7fafc;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        Text {
            text: summary;
            font-size: 11px;
            color: #94a3b8;
            wrap: word-wrap;
            overflow: elide;
            height: 34px;
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "by " + author;
                font-size: 10px;
                color: #64748b;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            SecondaryButton {
                text: root.action_text;
                button-width: 80px;
                button-height: 24px;
                clicked => { root.install_clicked(root.project_id, root.name, root.source) }
            }
        }
    }
}

struct ModpackInfo { name: string, minecraft_version: string, loader: string, ram_mb: int, icon: image, starred: bool }
struct ModFileInfo { filename: string, display_name: string, enabled: bool, icon: image, duplicate: bool, dup_total: int, orphan: bool }
struct AccountInfo { id: string, username: string, kind: string, selected: bool }
struct StatRowUi { name: string, text: string, fraction: float }
struct PresetUi { id: string, name: string, mc_version: string, loader: string, mod_count: int, suggested_loader_version: string }
struct PresetModUi { project_id: string, project_name: string, icon: image }
struct WorldInfoUi { folder_name: string, display_name: string, icon: image, game_type_text: string, hardcore: bool, version: string, last_played_text: string }
struct ServerInfoUi { name: string, ip: string, icon: image, status: string, players_text: string, motd: string }
struct RunningInstance { name: string }
struct EnvVarUi { name: string, value: string }
struct JvmPresetUi { id: string, title: string, description: string, flags: string, suggested: bool }
struct WrapperUi { id: string, label: string, hint: string, available: bool, enabled: bool }
struct DuplicateUi { project_name: string, files: string }
struct CrashFindingUi { title: string, explanation: string, suggestion: string, mod_file: string }
struct LocalServerUi { name: string, mc_version: string, loader: string, port: int, running: bool, installed: bool, port_conflict: bool }
struct AchievementUi {
    title: string, title_big: string, description: string, kind: string, meta: string, short: string,
    line: string, header: string, instance: string, collapsed: bool, icon: image, is_new: bool,
}

// ===== Running Bar =====
component RunningBar inherits Rectangle {
    in property <[RunningInstance]> instances;
    in-out property <bool> expanded: false;
    callback force_stop(string);
    callback open_console(string);
    property <length> list_height: min(150px, max(40px, root.instances.length * 36px + 8px));
    height: root.expanded ? 36px + root.list_height : 36px;
    background: #111827;
    border-width: 1px;
    border-color: #1e293b;
    clip: true;
    animate height { duration: 200ms; easing: ease-in-out; }
    VerticalLayout {
        alignment: start;
        Rectangle {
            height: 36px;
            background: #0f1419;
            TouchArea { clicked => { root.expanded = !root.expanded; } }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                Text { text: root.expanded ? "▼" : "▲"; color: #64748b; vertical-alignment: center; font-size: 11px; }
                Text {
                    text: "Laufende Instanzen (" + root.instances.length + ")";
                    color: #f7fafc;
                    vertical-alignment: center;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }
            }
        }
        if root.expanded : ScrollView {
            height: root.list_height;
            VerticalLayout {
                alignment: start;
                spacing: 4px;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 6px;
                if root.instances.length == 0 : Text {
                    text: "Keine Instanz läuft.";
                    color: #64748b;
                    font-size: 12px;
                }
                for inst in root.instances : HorizontalLayout {
                    height: 32px;
                    spacing: 10px;
                    Text {
                        text: inst.name;
                        color: #f7fafc;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    SecondaryButton {
                        text: "Console";
                        button-width: 80px;
                        button-height: 26px;
                        clicked => { root.open_console(inst.name); }
                    }
                    DangerButton {
                        text: "Force Stop";
                        button-width: 100px;
                        button-height: 26px;
                        clicked => { root.force_stop(inst.name); }
                    }
                }
            }
        }
    }
}

// ===== Misc Card =====
component MiscCard inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <length> hint_height: 34px;
    background: #1a202c;
    border-radius: 10px;
    border-width: 1px;
    border-color: #1e293b;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text { text: root.title; color: #f7fafc; font-weight: 700; font-size: 14px; }
        if root.hint != "" : Text {
            text: root.hint;
            color: #94a3b8;
            font-size: 12px;
            wrap: word-wrap;
            height: root.hint_height;
            vertical-alignment: top;
            overflow: elide;
        }
        @children
    }
}

// ===== Achievement Card =====
component AchievementCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> meta;
    in property <string> kind;
    in property <image> icon;
    in property <bool> is_new: false;
    height: 88px;
    background: #1a202c;
    border-radius: 10px;
    border-width: 2px;
    border-color: root.is_new ? #10b981 : #1e293b;
    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            background: #0f1419;
            Text {
                text: root.kind == "challenge" ? "★" : (root.kind == "goal" ? "◆" : "●");
                color: root.kind == "challenge" ? #a78bfa : (root.kind == "goal" ? #3b82f6 : #10b981);
                font-size: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Image {
                source: root.icon;
                width: 44px;
                height: 44px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.title; color: root.is_new ? #10b981 : #f7fafc; font-size: 16px; font-weight: 800; overflow: elide; height: 22px; }
            Text { text: root.description; color: #94a3b8; font-size: 12px; overflow: elide; height: 18px; }
            Text { text: root.meta; color: #64748b; font-size: 10px; overflow: elide; height: 14px; }
        }
    }
}

// ===== Launch Overlay =====
component LaunchOverlay inherits Rectangle {
    in property <string> instance;
    in property <string> status;
    in property <float> progress;
    in-out property <int> t: 0;
    property <float> appear: min(1.0, root.t / 10.0);
    background: #000000dd;
    opacity: root.appear;
    Timer { interval: 30ms; running: true; triggered => { root.t += 1; } }
    TouchArea {}
    Rectangle {
        width: min(640px, parent.width - 40px);
        height: 360px;
        x: parent.width / 2 - self.width / 2;
        y: parent.height / 2 - self.height / 2 + (1.0 - root.appear) * 30px;
        background: #1a202c;
        border-radius: 20px;
        border-width: 1px;
        border-color: #2d3748;
        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            Text {
                text: "Starte " + root.instance;
                color: #94a3b8;
                font-size: 14px;
                horizontal-alignment: center;
                overflow: elide;
                height: 20px;
            }
            Rectangle {
                height: 52px;
                for i in 3 : Rectangle {
                    x: parent.width / 2 - 36px + i * 28px;
                    y: 30px - 26px * max(0.0, sin(root.t * 14deg - i * 50deg));
                    width: 18px;
                    height: 18px;
                    border-radius: 5px;
                    background: i == 0 ? #10b981 : (i == 1 ? #3b82f6 : #f59e0b);
                }
            }
            Text {
                text: root.status;
                color: #f7fafc;
                font-size: 26px;
                font-weight: 800;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
                overflow: elide;
            }
            Rectangle {
                height: 20px;
                border-radius: 10px;
                background: #0f1419;
                clip: true;
                Rectangle {
                    width: max(20px, parent.width * root.progress);
                    height: parent.height;
                    border-radius: 10px;
                    background: @linear-gradient(90deg, #10b981 0%, #3b82f6 100%);
                    clip: true;
                    animate width { duration: 400ms; easing: ease-out; }
                    Rectangle {
                        width: 80px;
                        height: parent.height;
                        x: (mod(root.t * 5.0, parent.width / 1px + 80.0) - 80.0) * 1px;
                        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff55 50%, #ffffff00 100%);
                    }
                }
            }
            Text {
                text: round(root.progress * 100) + " %";
                color: #64748b;
                font-size: 12px;
                horizontal-alignment: center;
                height: 16px;
            }
        }
    }
}

