import { Button, VerticalBox, GridBox, LineEdit, HorizontalBox, ComboBox, CheckBox, Slider } from "std-widgets.slint";

component ModpackTile inherits Rectangle {
    
    in property <string> name;
    in property <image> icon;

    min-width: 100px;
    min-height: 170px;
    max-width: 100px;
    max-height: 170px;

    callback modpack_play(string);
    callback modpack_details(string); // Klick irgendwo im Tile außer Play -> Detailansicht

    // Liegt HINTER dem restlichen Inhalt, fängt also nur Klicks ab, die nicht
    // vom Play-Button (der danach kommt und somit obenauf liegt) geschluckt werden.
    TouchArea {
        clicked => { root.modpack_details(root.name) }
    }

    VerticalLayout {
        spacing: 8px;
        padding: 10px;

        HorizontalLayout {
            alignment: center;
            Image { source: root.icon; width: 40px; height: 40px; }
        }
        Text { text: name; height: 20px; horizontal-alignment: center; color: white; wrap: word-wrap; }
        Button { text: "Play"; height: 40px; primary: true; clicked => {modpack_play(name)} }
    }
    
    
}

struct BrowserPackInfo { project_id: string, name: string, summary: string, author: string, icon: image }

component BrowserTile inherits Rectangle {
    in property <string> project_id;
    in property <string> name;
    in property <string> summary;
    in property <string> author;
    in property <image> icon;

    callback install_clicked(string, string); // project_id, name

    min-width: 220px;
    min-height: 110px;
    max-width: 220px;
    max-height: 110px;
    background: #2c3747;
    border-radius: 6px;

    VerticalLayout {
        spacing: 6px;
        padding: 12px;

        HorizontalLayout {
            spacing: 8px;
            Image { source: root.icon; width: 28px; height: 28px; }
            Text { text: name; font-size: 16px; font-weight: 700; color: white; vertical-alignment: center; }
        }
        Text { text: summary; font-size: 11px; color: #a0a8b5; wrap: word-wrap; }
        HorizontalLayout {
            Text { text: "by " + author; font-size: 10px; color: #7a8291; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Install"; height: 22px; clicked => { root.install_clicked(root.project_id, root.name) } } // Bei BrowserTile-Nutzung im Add-Mod-Popup zeigt der Button "Install", fügt dort aber direkt zur Instanz hinzu
        }
    }
}

struct ModpackInfo { name: string, minecraft_version: string, loader: string, ram_mb: int, icon: image }
struct ModFileInfo { filename: string, display_name: string, enabled: bool, icon: image } // filename = tatsächlicher Dateiname auf Platte (ggf. mit ".disabled")

export component AppWindow inherits Window {

    // Callbacks
    callback modpack_play(string);
    callback create_and_run(string, string, string);
    callback browser_search(string); // wird bei Enter/Edit im Suchfeld ausgelöst
    callback save_settings(int, string, string, bool, bool, bool); // ram, java_path, username, close_after_launch, open_on_startup, show_snapshots
    callback browser_open_install(string, string); // project_id, pack_name -> öffnet Install-Popup
    callback browser_confirm_install(int); // Index der gewählten Version in install_popup_versions

    // Detail-Ansicht einer einzelnen Instanz
    callback open_instance_details(string); // instance_name -> lädt Mods + Overrides, wechselt Panel
    callback detail_toggle_mod(string, string); // instance_name, filename -> enable/disable
    callback detail_remove_mod(string, string); // instance_name, filename
    callback detail_save_overrides(string, bool, int, string, string); // instance_name, enabled, ram, java_path, username
    callback detail_add_mod_search(string); // Suchtext im Add-Mod-Popup
    callback detail_add_mod_install(string, string, string); // instance_name, project_id, project_name -> lädt passende Version direkt in mods/

    // Vars
    in-out property <bool> popup_new_instance: false;
    in-out property <string> selected_panel: "Instanzen";
    in property <[ModpackInfo]> packs;
    in property <[string]> mcVersions;
    in property <[BrowserPackInfo]> browser_packs; // Ergebnisse der Modrinth-Suche

    // Settings-Werte, werden beim Start aus settings.json befüllt (siehe main.rs)
    in-out property <int> default_ram_mb: 2048;
    in-out property <string> java_path: "";
    in-out property <string> default_username: "TestUser";
    in-out property <bool> close_after_launch: false;
    in-out property <bool> open_on_startup: false;
    in-out property <bool> show_snapshots: false;

    // Install-Popup State (Version wählen für ein Pack aus dem Browser)
    in-out property <bool> install_popup_visible: false;
    in-out property <string> install_popup_pack_name: "";
    in property <[string]> install_popup_versions; // Labels, z.B. "1.2.0 (1.21.1)"
    in-out property <bool> install_popup_installing: false; // blockt Buttons während des Downloads
    in-out property <string> install_popup_status: ""; // Fortschritts- oder Fehlertext

    // Instanz-Detailansicht State
    in-out property <string> detail_instance_name: "";
    in-out property <image> detail_instance_icon;
    in property <[ModFileInfo]> detail_mod_files;
    in-out property <bool> detail_overrides_enabled: false;
    in-out property <int> detail_ram_mb: 2048;
    in-out property <string> detail_java_path: "";
    in-out property <string> detail_username: "";

    // Add-Mod-Popup State (innerhalb der Detailansicht)
    in-out property <bool> add_mod_popup_visible: false;
    in property <[BrowserPackInfo]> add_mod_results;
    in-out property <string> add_mod_status: "";

    // Global Style
    background: #313e50;
    min-width: 800px;
    min-height: 800px;

    GridLayout {
        HorizontalLayout {
            Rectangle { // Sidebar-Hintergrund: eigene Rectangle, da Layouts selbst keine background-Property haben
                width: 100px; // fest, sonst wird bei breitem Inhalt rechts mitgestreckt
                horizontal-stretch: 0; // nimmt sich keinen zusätzlichen Platz
                background: #232c3a; // dunkler als der Fenster-Hintergrund, dezente Abstufung im gleichen Farbschema

                VerticalLayout { // Selected Section
                    spacing: 4px;
                    padding: 8px;

                    TouchArea {
                        width: 100%;
                        height: 50px; // etwas höher, damit zweizeiliger Text (z.B. "Modpack Browser") reinpasst
                        clicked => { root.selected_panel = "Instanzen" }
                        Text {
                            text: "Instanzen";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: (root.selected_panel == "Instanzen" || root.selected_panel == "Instance Detail") ? red : white;
                        }
                    }
                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => {
                            root.selected_panel = "Modpack Browser";
                            // Beim ersten Öffnen direkt mit leerem Query laden, damit nicht erst gesucht werden muss
                            root.browser_search("");
                        }
                        Text {
                            text: "Modpack Browser";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: root.selected_panel == "Modpack Browser" ? red : white;
                        }
                    }
                    TouchArea {
                        width: 100%;
                        height: 50px;
                        clicked => { root.selected_panel = "Settings" }
                        Text {
                            text: "Settings";
                            horizontal-alignment: center;
                            font-size: 13px;
                            font-weight: 900;
                            wrap: word-wrap;
                            color: root.selected_panel == "Settings" ? red : white;
                        }
                    }
                }
            }
            GridLayout { // Panel
                horizontal-stretch: 1; // nimmt sich den kompletten Rest-Platz neben der Sidebar

                if selected_panel == "Instanzen" : VerticalLayout {
                    HorizontalLayout { // Steuer Elemente
                        max-height: 40px;

                        Button {
                            text: "New Instance";
                            primary: true;
                            clicked => {root.popup-new-instance = true}
                        }
                    }

                    GridLayout { // Installierte Modpacks
                        //Background Color change?                        
                        spacing: 20px;
                        padding: 20px;

                        for pack[i] in root.packs : ModpackTile {
                            name: pack.name;
                            icon: pack.icon;
                            row: floor(i / 3);
                            col: mod(i, 3);
                            background: #333;
                            modpack_play(n) => { root.modpack_play(n) }
                            modpack_details(n) => { root.open_instance_details(n) }
                        }

                    }
                }

                if selected_panel == "Modpack Browser" : VerticalLayout {
                    padding: 20px;
                    spacing: 20px;

                    HorizontalLayout { // Suchleiste
                        max-height: 40px;
                        spacing: 10px;

                        browser_search_box := LineEdit {
                            placeholder-text: "Modpacks durchsuchen...";
                            accepted(text) => { root.browser_search(text) } // Enter drücken zum Suchen
                        }
                        Button {
                            text: "Suchen";
                            width: 80px;
                            clicked => { root.browser_search(browser_search_box.text) }
                        }
                    }

                    GridLayout { // Ergebnis-Grid, kommt aus browser_packs (Modrinth)
                        spacing: 16px;

                        for pack[i] in root.browser_packs : BrowserTile {
                            row: floor(i / 3);
                            col: mod(i, 3);
                            project_id: pack.project_id;
                            name: pack.name;
                            summary: pack.summary;
                            author: pack.author;
                            icon: pack.icon;
                            install_clicked(id, n) => { root.browser_open_install(id, n) }
                        }
                    }

                    Rectangle { vertical-stretch: 1; } // Rest-Platz nach unten
                }

                if selected_panel == "Settings" : VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    alignment: start;

                    Text { text: "Allgemein"; font-size: 18px; font-weight: 700; color: white; }

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Standard-RAM (MB)"; color: white; vertical-alignment: center; width: 180px; }
                        ram_slider := Slider {
                            minimum: 1024;
                            maximum: 16384;
                            value: root.default_ram_mb;
                        }
                        Text { text: round(ram_slider.value) + " MB"; color: white; vertical-alignment: center; width: 80px; }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Java-Pfad"; color: white; vertical-alignment: center; width: 180px; }
                        java_path_box := LineEdit {
                            placeholder-text: "Automatisch erkannt";
                            text: root.java_path;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        max-height: 30px;
                        Text { text: "Standard-Nutzername"; color: white; vertical-alignment: center; width: 180px; }
                        username_box := LineEdit {
                            placeholder-text: "TestUser";
                            text: root.default_username;
                        }
                    }

                    Rectangle { height: 10px; } // Trenner-Abstand

                    Text { text: "Launcher"; font-size: 18px; font-weight: 700; color: white; }

                    close_after_launch_box := CheckBox { text: "Launcher nach Spielstart schließen"; checked: root.close_after_launch; }
                    open_on_startup_box := CheckBox { text: "Beim Systemstart öffnen"; checked: root.open_on_startup; }
                    show_snapshots_box := CheckBox { text: "Snapshot-Versionen anzeigen"; checked: root.show_snapshots; }

                    Rectangle { vertical-stretch: 1; }

                    Button {
                        text: "Speichern";
                        primary: true;
                        width: 120px;
                        clicked => {
                            // Werte erst lokal in die properties übernehmen, dann Callback feuern
                            root.default_ram_mb = round(ram_slider.value);
                            root.java_path = java_path_box.text;
                            root.default_username = username_box.text;
                            root.close_after_launch = close_after_launch_box.checked;
                            root.open_on_startup = open_on_startup_box.checked;
                            root.show_snapshots = show_snapshots_box.checked;

                            root.save_settings(
                                root.default_ram_mb,
                                root.java_path,
                                root.default_username,
                                root.close_after_launch,
                                root.open_on_startup,
                                root.show_snapshots,
                            );
                        }
                    }
                }

                if selected_panel == "Instance Detail" : VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    HorizontalLayout {
                        max-height: 30px;
                        spacing: 10px;

                        Button {
                            text: "< Zurück";
                            width: 90px;
                            clicked => { root.selected_panel = "Instanzen" }
                        }
                        Image { source: root.detail_instance_icon; width: 28px; height: 28px; }
                        Text {
                            text: root.detail_instance_name;
                            font-size: 20px;
                            font-weight: 900;
                            color: white;
                            vertical-alignment: center;
                        }
                    }

                    Text { text: "Mods"; font-size: 16px; font-weight: 700; color: white; }

                    HorizontalLayout {
                        max-height: 30px;
                        Button {
                            text: "+ Mod hinzufügen";
                            width: 160px;
                            clicked => {
                                root.add_mod_popup_visible = true;
                                root.add_mod_status = "";
                                root.detail_add_mod_search("");
                            }
                        }
                    }

                    // Liste der Mods im mods-Ordner dieser Instanz
                    VerticalLayout {
                        spacing: 4px;
                        for mod_file in root.detail_mod_files : HorizontalLayout {
                            max-height: 26px;
                            spacing: 10px;

                            Image { source: mod_file.icon; width: 20px; height: 20px; }
                            Text {
                                text: mod_file.display_name;
                                color: mod_file.enabled ? white : #7a8291; // deaktivierte Mods gedimmt
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: mod_file.enabled ? "Deaktivieren" : "Aktivieren";
                                width: 110px;
                                height: 24px;
                                clicked => { root.detail_toggle_mod(root.detail_instance_name, mod_file.filename) }
                            }
                            Button {
                                text: "Entfernen";
                                width: 90px;
                                height: 24px;
                                clicked => { root.detail_remove_mod(root.detail_instance_name, mod_file.filename) }
                            }
                        }
                    }

                    Rectangle { height: 10px; } // Trenner-Abstand

                    Text { text: "Einstellungen für diese Instanz"; font-size: 16px; font-weight: 700; color: white; }

                    detail_overrides_box := CheckBox {
                        text: "Eigene Einstellungen für diese Instanz verwenden (statt globaler Settings)";
                        checked: root.detail_overrides_enabled;
                    }

                    // FIX: vorher als "if detail_overrides_box.checked : VerticalLayout {...}" gebaut.
                    // Elemente in einem "if"-Block werden nur bedingt instanziiert - der Save-Button
                    // außerhalb konnte detail_ram_slider/detail_java_path_box/detail_username_box also
                    // nicht zuverlässig lesen. Jetzt immer vorhanden, nur über "visible" ausgeblendet.
                    VerticalLayout {
                        spacing: 10px;
                        visible: detail_overrides_box.checked;

                        HorizontalLayout {
                            spacing: 10px;
                            max-height: 30px;
                            Text { text: "RAM (MB)"; color: white; vertical-alignment: center; width: 180px; }
                            detail_ram_slider := Slider {
                                minimum: 1024;
                                maximum: 16384;
                                value: root.detail_ram_mb;
                            }
                            Text { text: round(detail_ram_slider.value) + " MB"; color: white; vertical-alignment: center; width: 80px; }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            max-height: 30px;
                            Text { text: "Java-Pfad"; color: white; vertical-alignment: center; width: 180px; }
                            detail_java_path_box := LineEdit {
                                placeholder-text: "Automatisch erkannt";
                                text: root.detail_java_path;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            max-height: 30px;
                            Text { text: "Nutzername"; color: white; vertical-alignment: center; width: 180px; }
                            detail_username_box := LineEdit {
                                placeholder-text: "TestUser";
                                text: root.detail_username;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Button {
                        text: "Overrides speichern";
                        primary: true;
                        width: 160px;
                        clicked => {
                            root.detail_overrides_enabled = detail_overrides_box.checked;
                            root.detail_ram_mb = round(detail_ram_slider.value);
                            root.detail_java_path = detail_java_path_box.text;
                            root.detail_username = detail_username_box.text;

                            root.detail_save_overrides(
                                root.detail_instance_name,
                                root.detail_overrides_enabled,
                                root.detail_ram_mb,
                                root.detail_java_path,
                                root.detail_username,
                            );
                        }
                    }
                }
            }
        }
    }

    if popup_new_instance : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {popup_new_instance = false}
        }

        Rectangle {
            width: 50%;
            height: 50%;

            x: parent.width/4;
            y: parent.height/4;

            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 20px;
                padding: 10px;

                Text {
                    text: "Instance Name";
                    vertical-alignment: bottom;
                    horizontal-alignment: center;
                }
                instance_name := LineEdit {
                    placeholder-text: "Instance Name here...";
                }
                
                Text {
                    text: "Minecraft Version";
                    vertical-alignment: bottom;
                    horizontal-alignment: center;
                }
                instance_version := ComboBox {
                    model: mcVersions;
                }

                Text {
                    text: "Modloader";
                    vertical-alignment: bottom;
                    horizontal-alignment: center;
                }
                instance_modloader := ComboBox {
                    model: ["Vanilla", "Fabric", "Forge", "neoforge"];
                }

                Button {
                    text: "Create & Run";
                    clicked => {create_and_run(instance_name.text, instance_version.current-value, instance_modloader.current-value)}
                }

            }
        }
    }

    // Install-Popup: Version eines Modpacks aus dem Browser auswählen.
    // Mehrfach-Installation ist möglich, da jede Bestätigung eine neue,
    // eigene Instanz anlegt (Name enthält die gewählte Version) statt eine
    // bestehende zu überschreiben. Zeigt während des Downloads Fortschritt
    // (install_popup_status) und blockt die Buttons (install_popup_installing).
    if install_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => {
                if (!root.install_popup_installing) {
                    root.install_popup_visible = false;
                }
            }
        }

        Rectangle {
            width: 40%;
            height: 34%;

            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;

            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 16px;
                padding: 16px;

                Text {
                    text: "Version installieren: " + root.install_popup_pack_name;
                    color: white;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                install_version_combo := ComboBox {
                    model: root.install_popup_versions; // Labels wie "1.2.0 (1.21.1)"
                    enabled: !root.install_popup_installing;
                }

                if root.install_popup_status != "" : Text {
                    text: root.install_popup_status;
                    color: #a0d8a0; // dezent grün, dient auch für Fehlermeldungen (kein extra Rot-Handling gewünscht -> einfach gehalten)
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Button {
                        text: "Abbrechen";
                        enabled: !root.install_popup_installing;
                        clicked => { root.install_popup_visible = false }
                    }
                    Button {
                        text: root.install_popup_installing ? "Installiere..." : "Installieren";
                        primary: true;
                        enabled: !root.install_popup_installing;
                        clicked => {
                            root.install_popup_installing = true;
                            root.install_popup_status = "Installation wird gestartet...";
                            root.browser_confirm_install(install_version_combo.current-index);
                        }
                    }
                }
            }
        }
    }

    // Add-Mod-Popup: innerhalb der Instanz-Detailansicht, sucht Mods (nicht
    // Modpacks) über Modrinth und installiert per Klick direkt in mods/.
    if add_mod_popup_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => { root.add_mod_popup_visible = false }
        }

        Rectangle {
            width: 60%;
            height: 60%;

            x: parent.width/2 - self.width/2;
            y: parent.height/2 - self.height/2;

            background: #2c3747;

            TouchArea {}

            VerticalLayout {
                spacing: 16px;
                padding: 16px;

                HorizontalLayout {
                    max-height: 40px;
                    spacing: 10px;

                    add_mod_search_box := LineEdit {
                        placeholder-text: "Mods durchsuchen...";
                        accepted(text) => { root.detail_add_mod_search(text) }
                    }
                    Button {
                        text: "Suchen";
                        width: 80px;
                        clicked => { root.detail_add_mod_search(add_mod_search_box.text) }
                    }
                    Button {
                        text: "Schließen";
                        width: 90px;
                        clicked => { root.add_mod_popup_visible = false }
                    }
                }

                if root.add_mod_status != "" : Text {
                    text: root.add_mod_status;
                    color: #a0d8a0;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    font-size: 12px;
                }

                GridLayout {
                    spacing: 16px;

                    for pack[i] in root.add_mod_results : BrowserTile {
                        row: floor(i / 2);
                        col: mod(i, 2);
                        project_id: pack.project_id;
                        name: pack.name;
                        summary: pack.summary;
                        author: pack.author;
                        icon: pack.icon;
                        install_clicked(id, n) => { root.detail_add_mod_install(root.detail_instance_name, id, n) }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}